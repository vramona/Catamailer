@using Catamailer.Domain

<li class="cata-tree-node">
    <div class="cata-tree-node-content d-flex align-items-center">
        @if (Node.Children.Any())
        {
            <button class="btn btn-sm btn-link p-0 text-decoration-none text-muted cata-tree-toggle-spacer me-1" style="font-size: 0.65rem; width: 1rem; line-height: 1;" @onclick="Toggle" aria-label="Déplier/Replier">
                @(isExpanded ? "▼" : "▶")
            </button>
        }
        else
        {
            <span class="cata-tree-toggle-spacer me-1" style="width: 1rem; display: inline-block;"></span>
        }

        @if (!string.IsNullOrEmpty(Node.Color))
        {
            <span class="me-1 flex-shrink-0" style="background-color: @Node.Color; width: 0.65rem; height: 0.65rem; display: inline-block; border-radius: 50%;"></span>
        }
        else if (!string.IsNullOrEmpty(Node.EffectiveColor))
        {
            <span class="me-1 border flex-shrink-0" style="background-color: @Node.EffectiveColor; width: 0.65rem; height: 0.65rem; display: inline-block; border-radius: 50%; opacity: 0.6;" title="Couleur héritée"></span>
        }
        else
        {
            <span class="me-1 bg-light border flex-shrink-0" style="width: 0.65rem; height: 0.65rem; display: inline-block; border-radius: 50%;"></span>
        }
        
        <span class="text-dark flex-grow-1 text-truncate" style="font-size: 0.75rem; line-height: 1.15;">@Node.Name</span>

        <button class="btn btn-outline-danger border-0 ms-1 p-0 px-1" style="font-size: 0.65rem; line-height: 1;" @onclick="DeleteNodeAsync" title="Supprimer la catégorie">
            🗑️
        </button>
    </div>
    
    @if (isExpanded && Node.Children.Any())
    {
        <CategoryTreeView Nodes="Node.Children" OnNodeDeleted="OnNodeDeleted" />
    }
</li>

@code {
    /// <summary>
    /// Le nœud de catégorie à afficher.
    /// </summary>
    [Parameter, EditorRequired]
    public CategoryNode Node { get; set; } = default!;

    /// <summary>
    /// Événement déclenché lorsqu'une demande de suppression est émise par ce nœud ou l'un de ses enfants.
    /// </summary>
    [Parameter]
    public EventCallback<CategoryNode> OnNodeDeleted { get; set; }

    private bool isExpanded = false;

    private void Toggle()
    {
        isExpanded = !isExpanded;
    }

    private Task DeleteNodeAsync()
    {
        return OnNodeDeleted.InvokeAsync(Node);
    }
}