@using Catamailer.Domain

<li class="cata-tree-node">
    <div class="cata-tree-node-content d-flex align-items-center">
        @if (Node.Children.Any())
        {
            <button class="btn btn-sm btn-link p-0 text-decoration-none text-dark cata-tree-toggle-spacer" @onclick="Toggle" aria-label="Déplier/Replier">
                @(isExpanded ? "▼" : "▶")
            </button>
        }
        else
        {
            <span class="cata-tree-toggle-spacer"></span>
        }

        @if (!string.IsNullOrEmpty(Node.Color))
        {
            <span class="badge me-2 shadow-sm" style="background-color: @Node.Color; width: 1.2rem; height: 1.2rem; display: inline-block;">&nbsp;</span>
        }
        else if (!string.IsNullOrEmpty(Node.EffectiveColor))
        {
            <span class="badge me-2 border shadow-sm" style="background-color: @Node.EffectiveColor; width: 1.2rem; height: 1.2rem; display: inline-block;" title="Couleur héritée">&nbsp;</span>
        }
        else
        {
            <span class="badge me-2 bg-light border text-dark shadow-sm" style="width: 1.2rem; height: 1.2rem; display: inline-block;">&nbsp;</span>
        }
        
        <span class="fs-6 text-dark flex-grow-1">@Node.Name</span>

        <button class="btn btn-sm btn-outline-danger border-0 ms-2" @onclick="DeleteNodeAsync" title="Supprimer la catégorie">
            🗑️
        </button>
    </div>
    
    @if (isExpanded && Node.Children.Any())
    {
        <CategoryTreeView Nodes="Node.Children" OnNodeDeleted="OnNodeDeleted" />
    }
</li>

@code {
    /// <summary>
    /// Le nœud de catégorie à afficher.
    /// </summary>
    [Parameter, EditorRequired]
    public CategoryNode Node { get; set; } = default!;

    /// <summary>
    /// Événement déclenché lorsqu'une demande de suppression est émise par ce nœud ou l'un de ses enfants.
    /// </summary>
    [Parameter]
    public EventCallback<CategoryNode> OnNodeDeleted { get; set; }

    private bool isExpanded = true;

    private void Toggle()
    {
        isExpanded = !isExpanded;
    }

    private Task DeleteNodeAsync()
    {
        return OnNodeDeleted.InvokeAsync(Node);
    }
}