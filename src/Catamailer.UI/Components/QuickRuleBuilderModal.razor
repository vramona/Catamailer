<div class="quick-rule-builder-container p-3 border rounded bg-white shadow-sm">
    <h5 class="mb-3">Création de Règle Rapide (Étape 1)</h5>

    <!-- Encadré de diagnostic multi-catégories et déclencheurs -->
    @if (ViewModel.ExistingOutlookCategories.Any() || ViewModel.TriggeredResults.Any())
    {
        <div class="card bg-light border mb-3">
            <div class="card-body py-2 px-3" style="font-size: 0.78rem;">
                @if (ViewModel.ExistingOutlookCategories.Any())
                {
                    <div class="mb-1">
                        <strong class="text-secondary me-2">Catégories Outlook actuelles :</strong>
                        @foreach (var outlookCat in ViewModel.ExistingOutlookCategories)
                        {
                            <span class="badge bg-secondary me-1">@outlookCat</span>
                        }
                    </div>
                }
                @if (ViewModel.TriggeredResults.Any())
                {
                    <div>
                        <strong class="text-dark me-2">Déclencheurs Catamailer détectés (@ViewModel.TriggeredResults.Count) :</strong>
                        @foreach (var match in ViewModel.TriggeredResults)
                        {
                            <span class="badge bg-warning text-dark me-1 border" title="@($"Champ: {match.TriggerField} | Valeur: {match.MatchedValue}")">
                                ⚡ @match.MatchedCategory.GetFullName("-") (@match.TriggerField : "@match.MatchedKeyword")
                            </span>
                        }
                    </div>
                }
            </div>
        </div>
    }

    <div class="row">
        <!-- Colonne Gauche : Arbre des catégories (replié par défaut sauf branches déclenchées) -->
        <div class="col-md-5 border-end">
            <h6 class="text-muted mb-2">1. Choisir la catégorie cible</h6>
            <div class="category-tree overflow-auto" style="max-height: 400px;">
                @if (ViewModel.Categories != null && ViewModel.Categories.Any())
                {
                    @foreach (var rootNode in ViewModel.Categories.Where(c => c.Parent == null).OrderBy(c => c.Name))
                    {
                        @RenderTree(rootNode)
                    }
                }
                else
                {
                    <span class="text-muted">Aucune catégorie disponible.</span>
                }
            </div>
        </div>

        <!-- Colonne Droite : Configuration de la règle -->
        <div class="col-md-7">
            <h6 class="text-muted mb-2">2. Définir les critères de déclenchement</h6>
            
            @if (ViewModel.SelectedCategory == null)
            {
                <div class="alert alert-info py-2">Veuillez sélectionner une catégorie à gauche.</div>
            }
            else
            {
                <div class="rule-options mb-3">
                    <p class="fw-bold mb-2">Options extraites de l'e-mail pour <span class="text-primary">@ViewModel.SelectedCategory.GetFullName("-")</span> :</p>
                    
                    @if (ViewModel.SubjectOption != null)
                    {
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" id="chkSubject" @bind="ViewModel.SubjectOption.IsSelected" />
                            <label class="form-check-label fw-bold" for="chkSubject">Sujet</label>
                            <input type="text" class="form-control form-control-sm mt-1" @bind="ViewModel.SubjectOption.Value" />
                        </div>
                    }

                    @if (ViewModel.SenderOptions.Any())
                    {
                        <p class="fw-bold mb-1 mt-3">Expéditeurs</p>
                        @for (var i = 0; i < ViewModel.SenderOptions.Count; i++)
                        {
                            var option = ViewModel.SenderOptions[i];
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" id="@($"chkSender_{i}")" @bind="option.IsSelected" />
                                <label class="form-check-label d-none" for="@($"chkSender_{i}")">Expéditeur</label>
                                <input type="text" class="form-control form-control-sm" @bind="option.Value" />
                            </div>
                        }
                    }

                    @if (ViewModel.RecipientOptions.Any())
                    {
                        <p class="fw-bold mb-1 mt-3">Destinataires (Externes)</p>
                        @for (var i = 0; i < ViewModel.RecipientOptions.Count; i++)
                        {
                            var option = ViewModel.RecipientOptions[i];
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" id="@($"chkRecipient_{i}")" @bind="option.IsSelected" />
                                <label class="form-check-label d-none" for="@($"chkRecipient_{i}")">Destinataire</label>
                                <input type="text" class="form-control form-control-sm" @bind="option.Value" />
                            </div>
                        }
                    }
                </div>

                <button class="btn btn-primary w-100" @onclick="OnBuildRule">Créer la règle</button>
            }

            @if (_successMessage != null)
            {
                <div class="alert alert-success mt-3 mb-0 py-2">
                    @_successMessage
                </div>
            }
        </div>
    </div>
</div>

@code {
    private string? _successMessage;
    private readonly HashSet<string> _expandedPaths = new(StringComparer.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        await ViewModel.InitializeAsync();
        InitializeExpandedBranches();
    }

    private void InitializeExpandedBranches()
    {
        _expandedPaths.Clear();
        foreach (var cat in ViewModel.TriggeredCategories)
        {
            if (cat.Children.Any())
            {
                _expandedPaths.Add(cat.GetFullName("-"));
            }
        }
    }

    private void ToggleNode(CategoryNode category)
    {
        var fullPath = category.GetFullName("-");
        if (!_expandedPaths.Remove(fullPath))
        {
            _expandedPaths.Add(fullPath);
        }
    }

    private void SelectCategory(CategoryNode category)
    {
        ViewModel.SelectCategory(category);
        _successMessage = null;
    }

    private void OnBuildRule()
    {
        var rule = ViewModel.BuildRule();
        if (rule != null)
        {
            var allKws = new List<string>();
            if (rule.SubjectKeywords != null) allKws.AddRange(rule.SubjectKeywords);
            if (rule.SenderKeywords != null) allKws.AddRange(rule.SenderKeywords);
            if (rule.RecipientKeywords != null) allKws.AddRange(rule.RecipientKeywords);

            if (allKws.Any())
            {
                _successMessage = $"Règle créée : assignation de [{rule.TargetCategory.GetFullName("-")}] sur détection de ({string.Join(" OU ", allKws)}).";
            }
            else
            {
                _successMessage = $"Attention : Règle créée pour [{rule.TargetCategory.GetFullName("-")}], mais aucune case n'a été cochée.";
            }
        }
    }

    private RenderFragment<CategoryNode> RenderTree => category => __builder =>
    {
        var fullPath = category.GetFullName("-");
        var directMatch = ViewModel.TriggeredResults.FirstOrDefault(r =>
            string.Equals(r.MatchedCategory.GetFullName("-"), fullPath, StringComparison.OrdinalIgnoreCase));
        var isTriggeredInChain = ViewModel.TriggeredCategories.Any(c =>
            string.Equals(c.GetFullName("-"), fullPath, StringComparison.OrdinalIgnoreCase));
        var isSelected = ViewModel.SelectedCategory != null &&
                         string.Equals(ViewModel.SelectedCategory.GetFullName("-"), fullPath, StringComparison.OrdinalIgnoreCase);
        var bgColor = category.EffectiveColor ?? "#ccc";
        var hasChildren = category.Children.Any();
        var isExpanded = _expandedPaths.Contains(fullPath);

        <div class="category-node" style="margin-left: @(category.Depth == 0 ? 0 : 14)px;">
            <div class="d-flex align-items-center mb-1 py-1 px-1 rounded @(isSelected ? "bg-light border border-primary" : "")"
                 style="cursor: pointer; font-size: 0.78rem;"
                 @onclick="() => SelectCategory(category)">
                @if (hasChildren)
                {
                    <span class="text-muted me-1" style="width: 1rem; display: inline-block; text-align: center; font-size: 0.65rem;"
                          @onclick:stopPropagation="true"
                          @onclick="() => ToggleNode(category)">
                        @(isExpanded ? "▼" : "▶")
                    </span>
                }
                else
                {
                    <span class="me-1" style="width: 1rem; display: inline-block;"></span>
                }

                <span class="badge rounded-pill me-1" style="background-color: @bgColor; width: 10px; height: 10px; padding: 0; display: inline-block;"></span>
                <span class="text-truncate @(isSelected ? "fw-bold text-primary" : "")" title="@fullPath">@category.Name</span>
                @if (directMatch != null)
                {
                    <span class="badge bg-warning text-dark ms-2" title="@($"{directMatch.TriggerField} : {directMatch.MatchedKeyword}")">
                        ⚡ @directMatch.MatchedKeyword
                    </span>
                }
                else if (isTriggeredInChain)
                {
                    <span class="badge bg-light text-secondary border ms-2" title="Parent d'une catégorie déclenchée">↑ Parent</span>
                }
            </div>
            @if (hasChildren && isExpanded)
            {
                <div class="children-container border-start ms-2 border-1 border-light">
                    @foreach (var child in category.Children.OrderBy(c => c.Name))
                    {
                        @RenderTree(child)
                    }
                </div>
            }
        </div>
    };
}