@using Catamailer.Domain

<ul class="cata-tree">
    @foreach (var node in Nodes)
    {
        <CategoryTreeNode Node="node" />
    }
</ul>

@code {
    /// <summary>
    /// Obtient ou définit la liste des nœuds à afficher à ce niveau de la récursion.
    /// </summary>
    [Parameter, EditorRequired]
    public IEnumerable<CategoryNode> Nodes { get; set; } = Enumerable.Empty<CategoryNode>();
}