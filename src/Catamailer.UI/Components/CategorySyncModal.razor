@using Catamailer.Application.ViewModels
@using Catamailer.Domain.Sync
@inject CategorySyncViewModel ViewModel

@if (_isVisible && ViewModel.HasConflicts)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Synchronisation des Catégories</h5>
                </div>
                <div class="modal-body">
                    <p class="text-muted">
                        Des différences ont été détectées entre les catégories d'Outlook et celles de Catamailer. 
                        Sélectionnez les éléments à synchroniser.
                    </p>

                    @if (ViewModel.MissingInCatamailerOptions.Any())
                    {
                        <h6 class="mt-3">Ajouter à Catamailer (Manquantes en local)</h6>
                        <ul class="list-group mb-3">
                            @foreach (var option in ViewModel.MissingInCatamailerOptions)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <input type="checkbox" class="form-check-input me-2" @bind="option.IsSelected" />
                                        @option.Delta.CategoryName
                                    </div>
                                    @if (!string.IsNullOrEmpty(option.Delta.OutlookColor))
                                    {
                                        <span class="badge" style="background-color: @option.Delta.OutlookColor">@option.Delta.OutlookColor</span>
                                    }
                                </li>
                            }
                        </ul>
                    }

                    @if (ViewModel.MissingInOutlookOptions.Any())
                    {
                        <h6 class="mt-3">Ajouter à Outlook (Manquantes dans la messagerie)</h6>
                        <ul class="list-group mb-3">
                            @foreach (var option in ViewModel.MissingInOutlookOptions)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <input type="checkbox" class="form-check-input me-2" @bind="option.IsSelected" />
                                        @option.Delta.CategoryName
                                    </div>
                                    @if (!string.IsNullOrEmpty(option.Delta.CatamailerColor))
                                    {
                                        <span class="badge" style="background-color: @option.Delta.CatamailerColor">@option.Delta.CatamailerColor</span>
                                    }
                                </li>
                            }
                        </ul>
                    }

                    @if (ViewModel.ColorMismatchOptions.Any())
                    {
                        <h6 class="mt-3">Conflits de Couleur (Catamailer écrase Outlook)</h6>
                        <ul class="list-group mb-3">
                            @foreach (var option in ViewModel.ColorMismatchOptions)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <input type="checkbox" class="form-check-input me-2" @bind="option.IsSelected" />
                                        @option.Delta.CategoryName
                                    </div>
                                    <div>
                                        <span class="badge me-1" style="background-color: @option.Delta.OutlookColor; color: black; border: 1px solid #ccc;" title="Couleur Outlook">
                                            Outlook
                                        </span>
                                        <span>➔</span>
                                        <span class="badge ms-1" style="background-color: @option.Delta.CatamailerColor; color: black; border: 1px solid #ccc;" title="Couleur Catamailer">
                                            Catamailer
                                        </span>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="IgnoreAsync">Ignorer pour le moment</button>
                    <button class="btn btn-primary" @onclick="ApplyAsync">Appliquer la synchronisation</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool _isVisible = true;

    [Parameter]
    public EventCallback OnSyncCompleted { get; set; }

    [Parameter]
    public EventCallback OnSyncIgnored { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await ViewModel.InitializeAsync();
    }

    private async Task ApplyAsync()
    {
        await ViewModel.ApplyResolutionsAsync();
        _isVisible = false;
        
        if (OnSyncCompleted.HasDelegate)
        {
            await OnSyncCompleted.InvokeAsync();
        }
    }

    private async Task IgnoreAsync()
    {
        _isVisible = false;
        
        if (OnSyncIgnored.HasDelegate)
        {
            await OnSyncIgnored.InvokeAsync();
        }
    }
}