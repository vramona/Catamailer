@using Catamailer.Application.ViewModels
@inject ActivationPromptViewModel ViewModel

<!-- ------------------------------------------------------------------------------
// <auto-generated>
//     Date de création : 2026-09-15
//     Historique :
//         - 2026-09-15 : Création du composant d'alerte pour le Shadow Mode (J3-S3-T5 - Phase Bleue).
// </auto-generated>
// ------------------------------------------------------------------------------ -->

@if (ViewModel.ShouldShowPrompt)
{
    <div class="alert alert-info alert-dismissible shadow-lg m-3 position-fixed bottom-0 end-0" style="z-index: 1050; max-width: 400px;" role="alert">
        <h5 class="alert-heading fw-bold">🚀 Shadow Mode Performant !</h5>
        <p class="mb-3">
            Catamailer a classé un nombre significatif de vos emails avec succès en arrière-plan. 
            Souhaitez-vous activer l'écriture automatique des catégories dans Outlook ?
        </p>
        <hr>
        <div class="d-flex justify-content-end">
            <button type="button" class="btn btn-outline-secondary me-2" @onclick="AcknowledgeAndCloseAsync">Plus tard</button>
            <button type="button" class="btn btn-primary" @onclick="ActivateAndCloseAsync">Activer maintenant</button>
        </div>
    </div>
}

@code {
    protected override async Task OnInitializedAsync()
    {
        await ViewModel.InitializeAsync();
    }

    private async Task ActivateAndCloseAsync()
    {
        await ViewModel.ActivateAsync();
    }

    private async Task AcknowledgeAndCloseAsync()
    {
        await ViewModel.AcknowledgeAsync();
    }
}