<div class="page">
    <!-- BANDEAU SUPÉRIEUR FIXE -->
    <header class="bg-dark text-white px-3 py-2 shadow-sm d-flex justify-content-between align-items-center flex-shrink-0">
        <div class="fw-bold fs-6">Catamailer</div>
        <nav class="d-flex align-items-center" style="font-size: 0.85rem;">
            <a href="/" class="text-white text-decoration-none me-3">Dashboard</a>
            <a href="/category-editor" class="text-white text-decoration-none me-3">Catégories</a>
            <a href="/category-sync" class="text-white text-decoration-none me-3">Synchronisation</a>
            <a href="/dictionary-editor" class="text-white text-decoration-none me-3">Dictionnaires</a>
            <a href="/rule-builder" class="text-white text-decoration-none me-3">Règles</a>
            <a href="/preferences" class="text-white text-decoration-none me-4">Préférences</a>
            <button class="btn btn-outline-light btn-sm py-0 px-2" style="font-size: 0.8rem;" @onclick="RequestExit">Quitter</button>
        </nav>
    </header>

    <!-- ZONE PRINCIPALE (CONTIENT LE CORPS SCROLLABLE ET LA BARRE D'ACTION FIXE DE L'ÉCRAN) -->
    <main>
        <article class="content">
            @Body
        </article>
    </main>

    <!-- BARRE DE STATUT INFÉRIEURE FIXE (STYLE OUTLOOK) -->
    <footer class="cata-status-bar">
        <div class="d-flex align-items-center">
            <span class="cata-status-item">
                <strong>Catégories :</strong>&nbsp;@StatusBarVM.TotalCategoriesCount
            </span>
            <span class="cata-status-item">
                <strong>Règles Étape 1 (Dictionnaires) :</strong>&nbsp;@StatusBarVM.TotalDictionaryRulesCount
            </span>
            <span class="cata-status-item">
                <strong>Règles Étape 2 (Exécution) :</strong>&nbsp;@StatusBarVM.TotalExecutionRulesCount
            </span>
        </div>
        <div class="d-flex align-items-center">
            <span class="cata-status-item">
                Mode :&nbsp;<strong>@(StatusBarVM.IsAutoWriteEnabled ? "🟢 Actif (Écriture Outlook)" : "🛡️ Shadow Mode (Lecture seule)")</strong>
            </span>
            <span class="cata-status-item text-white-50">
                [Échap] Accueil
            </span>
        </div>
    </footer>
    
    <Catamailer.UI.Components.ActivationPrompt />
</div>

@code {
    private DotNetObjectReference<MainLayout>? _objRef;

    protected override async Task OnInitializedAsync()
    {
        BlazorNavigation.NavigationRequested += OnNavigationRequested;
        NavigationManager.LocationChanged += OnLocationChanged;
        await StatusBarVM.InitializeAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _objRef = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("catamailerShortcuts.registerEscapeHandler", _objRef);
        }
    }

    [JSInvokable]
    public async Task OnEscapePressed()
    {
        await InvokeAsync(() =>
        {
            var currentUri = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
            if (!string.IsNullOrEmpty(currentUri))
            {
                NavigationManager.NavigateTo("/");
            }
        });
    }

    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        await InvokeAsync(async () =>
        {
            await StatusBarVM.RefreshAsync();
            StateHasChanged();
        });
    }

    private void OnNavigationRequested(object? sender, string uri)
    {
        InvokeAsync(() => NavigationManager.NavigateTo(uri));
    }

    private void RequestExit()
    {
        BlazorNavigation.RequestExit();
    }

    public void Dispose()
    {
        BlazorNavigation.NavigationRequested -= OnNavigationRequested;
        NavigationManager.LocationChanged -= OnLocationChanged;
        _objRef?.Dispose();
    }
}