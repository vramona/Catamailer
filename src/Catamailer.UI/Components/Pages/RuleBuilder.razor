<h1 class="cata-page-title">Builder Visuel de Règles (Étape 2)</h1>
<p class="text-muted mb-4">Construisez l'arborescence des conditions d'exécution de vos règles.</p>

<div class="card shadow-sm border-0 bg-white mb-4">
    <div class="card-body">
        <label class="form-label fw-medium">Nom de la règle <span class="text-danger">*</span></label>
        <input type="text" class="form-control" @bind="ViewModel.RuleName" @bind:event="oninput" placeholder="Ex: Règle de classement Factures" />
    </div>
</div>

<div class="card shadow-sm border-0 bg-white mb-4">
    <div class="card-body">
        @RenderNode(ViewModel.RootNode, true)
    </div>
</div>

<div class="card shadow-sm border-0 bg-white mb-4">
    <div class="card-header bg-light">
        <h5 class="mb-0">Action Finale</h5>
    </div>
    <div class="card-body">
        <div class="row align-items-end">
            <div class="col-md-4">
                <label class="form-label fw-medium">Type d'action <span class="text-danger">*</span></label>
                <select class="form-select" @onchange="OnActionTypeChanged">
                    <option value="">-- Sélectionner --</option>
                    @foreach (var actionType in Enum.GetValues(typeof(ActionType)).Cast<ActionType>())
                    {
                        <option value="@actionType" selected="@(ViewModel.FinalAction?.Type == actionType)">@actionType</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-medium">Paramètre (Dossier, Tag, etc.)</label>
                <input type="text" class="form-control" value="@ViewModel.FinalAction?.Parameter" @onchange="OnActionParameterChanged" placeholder="Ex: Archives" />
            </div>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between mt-4">
    <a href="/" class="btn btn-outline-secondary px-4 shadow-sm">
        ← Retour au Dashboard
    </a>
    <button class="btn btn-primary px-4 shadow-sm" @onclick="SaveRuleAsync" disabled="@(!CanSave)">
        💾 Sauvegarder la règle
    </button>
</div>

@code {
    private ActionType? _selectedActionType;
    private string _actionParameter = string.Empty;
    private Dictionary<RuleCriterion, bool> _dropdownStates = new();

    private bool CanSave => !string.IsNullOrWhiteSpace(ViewModel.RuleName) && ViewModel.FinalAction != null;

    protected override async Task OnInitializedAsync()
    {
        await ViewModel.InitializeAsync();

        if (ViewModel.FinalAction != null)
        {
            _selectedActionType = ViewModel.FinalAction.Type;
            _actionParameter = ViewModel.FinalAction.Parameter;
        }
    }

    private RenderFragment RenderNode(RuleNode node, bool isRoot = false) => __builder =>
    {
        <div class="card mb-3 @(isRoot ? "border-primary" : "border-secondary ms-4")">
            <div class="card-header d-flex justify-content-between align-items-center @(isRoot ? "bg-primary text-white" : "bg-light")">
                <div class="d-flex align-items-center">
                    <span class="fw-bold me-2">Opérateur Logique :</span>
                    <select class="form-select form-select-sm w-auto d-inline-block" @onchange="(e) => UpdateNodeOperator(node, e)">
                        @foreach (var op in Enum.GetValues(typeof(LogicalOperator)).Cast<LogicalOperator>())
                        {
                            <option value="@op" selected="@(node.Operator == op)">@op</option>
                        }
                    </select>
                </div>
                <div>
                    <button class="btn btn-sm @(isRoot ? "btn-light text-primary" : "btn-outline-primary") me-2" @onclick="() => AddCriterion(node)">+ Ajouter un Critère</button>
                    <button class="btn btn-sm @(isRoot ? "btn-light text-primary" : "btn-outline-secondary") me-2" @onclick="() => AddChildNode(node)">+ Ajouter un Groupe</button>
                    @if (!isRoot)
                    {
                        <button class="btn btn-sm btn-danger" @onclick="() => RemoveNode(node)">Supprimer ce groupe</button>
                    }
                </div>
            </div>
            <div class="card-body">
                @if (!node.Criteria.Any() && !node.ChildNodes.Any())
                {
                    <div class="text-muted fst-italic">Aucun critère ou groupe défini.</div>
                }

                @foreach (var crit in node.Criteria)
                {
                    <div class="row g-2 mb-2 align-items-center">
                        <div class="col-auto">
                            <span class="badge bg-secondary px-3 py-2">Critère</span>
                        </div>
                        <div class="col-md-3">
                            <select class="form-select form-select-sm" @onchange="(e) => UpdateCriterionField(node, crit, e)">
                                @foreach (var field in Enum.GetValues(typeof(MailField)).Cast<MailField>())
                                {
                                    <option value="@field" selected="@(crit.Field == field)">@field</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <select class="form-select form-select-sm" @onchange="(e) => UpdateCriterionOperator(node, crit, e)">
                                @foreach (var matchOp in GetAvailableOperators(crit.Field))
                                {
                                    <option value="@matchOp" selected="@(crit.Operator == matchOp)">@matchOp</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            @if (crit.Field == MailField.Category)
                            {
                                var selectedCat = ViewModel.FlatCategories.FirstOrDefault(c => c.FullName == crit.Value);
                                var selectedColor = selectedCat?.Node.EffectiveColor ?? "transparent";
                                var selectedName = selectedCat?.FullName ?? "-- Sélectionner une catégorie --";

                                <div class="dropdown position-relative">
                                    <button class="btn btn-outline-secondary btn-sm dropdown-toggle w-100 text-start d-flex align-items-center justify-content-between bg-white" type="button" @onclick="() => ToggleDropdown(crit)">
                                        <div class="d-flex align-items-center text-truncate">
                                            @if (selectedCat != null)
                                            {
                                                <span style="width: 12px; height: 12px; border-radius: 50%; display: inline-block; background-color: @selectedColor; margin-right: 8px; flex-shrink: 0; border: 1px solid #dee2e6;"></span>
                                            }
                                            <span class="text-truncate">@selectedName</span>
                                        </div>
                                    </button>
                                    @if (IsDropdownOpen(crit))
                                    {
                                        <ul class="dropdown-menu w-100 shadow-sm show" style="display: block; max-height: 300px; overflow-y: auto; position: absolute; z-index: 1050; top: 100%; left: 0;">
                                            <li>
                                                <button type="button" class="dropdown-item text-muted" @onclick="() => UpdateCategoryCriterionValue(node, crit, string.Empty)">
                                                    -- Sélectionner une catégorie --
                                                </button>
                                            </li>
                                            @foreach (var cat in ViewModel.FlatCategories)
                                            {
                                                var color = cat.Node.EffectiveColor ?? "transparent";
                                                <li>
                                                    <button type="button" class="dropdown-item d-flex align-items-center" @onclick="() => UpdateCategoryCriterionValue(node, crit, cat.FullName)">
                                                        <span style="width: 12px; height: 12px; border-radius: 50%; display: inline-block; background-color: @color; margin-right: 8px; flex-shrink: 0; border: 1px solid #dee2e6;"></span>
                                                        <span style="white-space: pre-wrap;">@cat.DisplayName</span>
                                                    </button>
                                                </li>
                                            }
                                        </ul>
                                    }
                                </div>
                            }
                            else
                            {
                                <input type="text" class="form-control form-control-sm" value="@crit.Value" @onchange="(e) => UpdateCriterionValue(node, crit, e)" placeholder="Valeur" />
                            }
                        </div>
                        <div class="col-auto">
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveCriterion(node, crit)">X</button>
                        </div>
                    </div>
                }

                @foreach (var child in node.ChildNodes)
                {
                    <div class="mt-3">
                        @RenderNode(child, false)
                    </div>
                }
            </div>
        </div>
    };

    private bool IsDropdownOpen(RuleCriterion crit) => _dropdownStates.TryGetValue(crit, out var isOpen) && isOpen;

    private void ToggleDropdown(RuleCriterion crit)
    {
        var isOpen = IsDropdownOpen(crit);
        _dropdownStates.Clear(); // Ferme les autres éventuelles listes
        _dropdownStates[crit] = !isOpen;
    }

    private void CloseDropdowns()
    {
        _dropdownStates.Clear();
    }

    private IEnumerable<MatchOperator> GetAvailableOperators(MailField field)
    {
        if (field == MailField.Category)
        {
            return new[] { MatchOperator.ExactNode, MatchOperator.NodeAndChildren };
        }
        return new[] { MatchOperator.Equals, MatchOperator.Contains, MatchOperator.RegexMatch };
    }

    private void AddCriterion(RuleNode node)
    {
        ViewModel.AddCriterion(node, new RuleCriterion(MailField.Subject, MatchOperator.Contains, "Nouveau mot-clé"));
        CloseDropdowns();
        StateHasChanged();
    }

    private void AddChildNode(RuleNode node)
    {
        ViewModel.AddChildNode(node, new RuleNode(LogicalOperator.Or));
        CloseDropdowns();
        StateHasChanged();
    }

    private void RemoveCriterion(RuleNode node, RuleCriterion crit)
    {
        ViewModel.RemoveCriterion(node, crit);
        _dropdownStates.Remove(crit);
        StateHasChanged();
    }

    private void RemoveNode(RuleNode nodeToRemove)
    {
        RemoveNodeRecursive(ViewModel.RootNode, nodeToRemove);
        CloseDropdowns();
        StateHasChanged();
    }

    private bool RemoveNodeRecursive(RuleNode current, RuleNode target)
    {
        if (current.ChildNodes.Contains(target))
        {
            current.RemoveChildNode(target);
            return true;
        }

        foreach (var child in current.ChildNodes)
        {
            if (RemoveNodeRecursive(child, target))
            {
                return true;
            }
        }
        return false;
    }

    private void UpdateNodeOperator(RuleNode node, ChangeEventArgs e)
    {
        if (Enum.TryParse<LogicalOperator>(e.Value?.ToString(), out var newOp))
        {
            ViewModel.SetOperator(node, newOp);
            StateHasChanged();
        }
    }

    private void UpdateCriterionField(RuleNode node, RuleCriterion crit, ChangeEventArgs e)
    {
        if (Enum.TryParse<MailField>(e.Value?.ToString(), out var newField))
        {
            MatchOperator newOp = crit.Operator;
            string newValue = crit.Value;

            if (newField == MailField.Category)
            {
                newOp = MatchOperator.ExactNode;
                newValue = ViewModel.FlatCategories.FirstOrDefault()?.FullName ?? string.Empty;
            }
            else if (crit.Field == MailField.Category)
            {
                newOp = MatchOperator.Contains;
                newValue = string.Empty;
            }

            var newCrit = new RuleCriterion(newField, newOp, newValue);
            ViewModel.UpdateCriterion(node, crit, newCrit);
            CloseDropdowns();
            StateHasChanged();
        }
    }

    private void UpdateCriterionOperator(RuleNode node, RuleCriterion crit, ChangeEventArgs e)
    {
        if (Enum.TryParse<MatchOperator>(e.Value?.ToString(), out var newOp))
        {
            var newCrit = new RuleCriterion(crit.Field, newOp, crit.Value);
            ViewModel.UpdateCriterion(node, crit, newCrit);
            CloseDropdowns();
            StateHasChanged();
        }
    }

    private void UpdateCriterionValue(RuleNode node, RuleCriterion crit, ChangeEventArgs e)
    {
        var newValue = e.Value?.ToString() ?? string.Empty;
        var newCrit = new RuleCriterion(crit.Field, crit.Operator, newValue);
        ViewModel.UpdateCriterion(node, crit, newCrit);
        CloseDropdowns();
        StateHasChanged();
    }

    private void UpdateCategoryCriterionValue(RuleNode node, RuleCriterion crit, string newValue)
    {
        var newCrit = new RuleCriterion(crit.Field, crit.Operator, newValue);
        ViewModel.UpdateCriterion(node, crit, newCrit);
        CloseDropdowns();
        StateHasChanged();
    }

    private void OnActionTypeChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<ActionType>(e.Value?.ToString(), out var actionType))
        {
            _selectedActionType = actionType;
            UpdateFinalAction();
        }
    }

    private void OnActionParameterChanged(ChangeEventArgs e)
    {
        _actionParameter = e.Value?.ToString() ?? string.Empty;
        UpdateFinalAction();
    }

    private void UpdateFinalAction()
    {
        if (_selectedActionType.HasValue)
        {
            ViewModel.SetAction(new RuleAction(_selectedActionType.Value, _actionParameter));
        }
    }

    private async Task SaveRuleAsync()
    {
        await ViewModel.SaveRuleAsync();
        NavManager.NavigateTo("/");
    }
}