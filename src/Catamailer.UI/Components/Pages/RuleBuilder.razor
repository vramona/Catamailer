<style>
    .builder-ultra-compact {
        font-size: 0.75rem;
    }
    .builder-ultra-compact .form-select,
    .builder-ultra-compact .form-control,
    .builder-ultra-compact .btn {
        font-size: 0.75rem;
    }
</style>

<div class="cata-screen-container builder-ultra-compact">

    <!-- EN-TÊTE ET NOM DE LA RÈGLE FIXES EN HAUT -->
    <div class="cata-screen-header">
        <div class="d-flex justify-content-between align-items-center mb-1">
            <div>
                <h1 class="cata-page-title mb-0">Builder Visuel de Règles (Étape 2)</h1>
                <p class="text-muted mb-0" style="font-size: 0.72rem;">Construisez l'arborescence des conditions d'exécution de vos règles.</p>
            </div>
            <div class="d-flex align-items-center w-50">
                <label class="form-label fw-medium mb-0 me-2 text-nowrap">Nom de la règle <span class="text-danger">*</span> :</label>
                <input type="text" class="form-control form-control-sm py-0" style="height: 24px;" @bind="ViewModel.RuleName" @bind:event="oninput" placeholder="Ex: Règle de classement Factures" />
            </div>
        </div>
    </div>

    <!-- CORPS DÉFILANT : ARBRE LOGIQUE ET ACTIONS -->
    <div class="cata-screen-body pe-1">
        <div class="card shadow-sm border bg-white mb-2">
            <div class="card-body p-2">
                @RenderNode(ViewModel.RootNode, true)
            </div>
        </div>

        <div class="card shadow-sm border bg-white mb-2">
            <div class="card-header bg-light d-flex justify-content-between align-items-center py-1 px-2">
                <h6 class="mb-0 fw-bold" style="font-size: 0.8rem;">Actions Finales Séquentielles</h6>
                <button class="btn btn-sm btn-outline-primary py-0 px-2" @onclick="AddNewActionAsync">+ Ajouter une action</button>
            </div>
            <div class="card-body p-2">
                @if (!ViewModel.Actions.Any())
                {
                    <div class="text-muted fst-italic">Aucune action définie. Ajoutez une action pour sauvegarder la règle.</div>
                }

                @foreach (var action in ViewModel.Actions.ToList())
                {
                    <div class="row g-2 align-items-end mb-2 pb-2 border-bottom">
                        <div class="col-md-4">
                            <label class="form-label fw-medium mb-1">Type d'action <span class="text-danger">*</span></label>
                            <select class="form-select form-select-sm py-0" style="height: 24px;" value="@action.Type" @onchange="@(e => UpdateActionTypeAsync(action, e))">
                                @foreach (ActionType actionType in Enum.GetValues(typeof(ActionType)))
                                {
                                    <option value="@actionType">@actionType</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium mb-1">Paramètre</label>
                            @if (action.Type == ActionType.SetImportance)
                            {
                                <select class="form-select form-select-sm py-0" style="height: 24px;" value="@action.Parameter" @onchange="@(e => UpdateActionParameter(action, e.Value?.ToString() ?? string.Empty))">
                                    <option value="Haute">Haute</option>
                                    <option value="Normale">Normale</option>
                                    <option value="Faible">Faible</option>
                                </select>
                            }
                            else if (action.Type == ActionType.MoveToFolder)
                            {
                                <select class="form-select form-select-sm py-0" style="height: 24px;" value="@action.Parameter" @onchange="@(e => UpdateActionParameter(action, e.Value?.ToString() ?? string.Empty))">
                                    <option value="">-- Sélectionner un dossier --</option>
                                    @foreach (var folder in ViewModel.AvailableFolders)
                                    {
                                        <option value="@folder">@folder</option>
                                    }
                                </select>
                            }
                            else if (action.Type == ActionType.InsertHtmlSignature)
                            {
                                <select class="form-select form-select-sm py-0" style="height: 24px;" value="@action.Parameter" @onchange="@(e => UpdateActionParameter(action, e.Value?.ToString() ?? string.Empty))">
                                    <option value="">-- Sélectionner une signature --</option>
                                    @foreach (var signature in ViewModel.AvailableSignatures)
                                    {
                                        <option value="@signature">@signature</option>
                                    }
                                </select>
                            }
                            else if (action.Type == ActionType.FlagToday || action.Type == ActionType.MarkAsRead)
                            {
                                <input type="text" class="form-control form-control-sm py-0" style="height: 24px;" value="N/A" disabled />
                            }
                            else if (action.Type == ActionType.AddReminder)
                            {
                                <input type="datetime-local" class="form-control form-control-sm py-0" style="height: 24px;" value="@GetDateString(action.Parameter)" @onchange="@(e => UpdateActionParameterDate(action, e.Value?.ToString() ?? string.Empty))" />
                            }
                            else
                            {
                                <input type="text" class="form-control form-control-sm py-0" style="height: 24px;" value="@action.Parameter" @onchange="@(e => UpdateActionParameter(action, e.Value?.ToString() ?? string.Empty))" placeholder="Destinataire, etc." />
                            }
                        </div>
                        <div class="col-auto">
                            <button class="btn btn-sm btn-outline-danger py-0 px-2" style="height: 24px;" @onclick="@(() => ViewModel.RemoveAction(action))">Supprimer</button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- ZONE D'ACTIONS STANDARDISÉE FIXE EN BAS -->
    <div class="cata-action-bar">
        <button class="btn btn-sm btn-outline-secondary px-3 py-1" @onclick='() => NavManager.NavigateTo("/")'>
            Annuler
        </button>
        <button class="btn btn-sm btn-primary px-3 py-1" @onclick="SaveRuleAsync" disabled="@(!CanSave)">
            💾 Sauvegarder la règle
        </button>
    </div>

</div>

@code {
    private Dictionary<RuleCriterion, bool> _dropdownStates = new();

    private bool CanSave => !string.IsNullOrWhiteSpace(ViewModel.RuleName) && ViewModel.Actions.Any();

    private string GetDateString(string paramValue)
    {
        if (DateTime.TryParse(paramValue, out var date))
        {
            return date.ToString("yyyy-MM-ddTHH:mm");
        }
        return string.Empty;
    }

    protected override async Task OnInitializedAsync()
    {
        await ViewModel.InitializeAsync();
    }

    private async Task AddNewActionAsync()
    {
        // On initialise par défaut sur MarkAsRead pour être instantané, et on ne charge les dossiers que si MoveToFolder est choisi
        ViewModel.AddAction(new RuleAction(ActionType.MarkAsRead, string.Empty));
        await Task.CompletedTask;
        StateHasChanged();
    }

    private async Task UpdateActionTypeAsync(RuleAction oldAction, ChangeEventArgs e)
    {
        if (Enum.TryParse<ActionType>(e.Value?.ToString(), out var newType))
        {
            string newParam = oldAction.Parameter;

            if (newType == ActionType.SetImportance)
            {
                newParam = "Normale";
            }
            else if (newType == ActionType.FlagToday || newType == ActionType.MarkAsRead)
            {
                newParam = string.Empty;
            }
            else if (newType == ActionType.MoveToFolder)
            {
                await ViewModel.EnsureFoldersLoadedAsync();
                newParam = ViewModel.AvailableFolders.FirstOrDefault() ?? string.Empty;
            }
            else if (newType == ActionType.InsertHtmlSignature)
            {
                newParam = ViewModel.AvailableSignatures.FirstOrDefault() ?? string.Empty;
            }

            var newAction = new RuleAction(newType, newParam);
            ViewModel.UpdateAction(oldAction, newAction);
            StateHasChanged();
        }
    }

    private void UpdateActionParameter(RuleAction oldAction, string newParameter)
    {
        var newAction = new RuleAction(oldAction.Type, newParameter);
        ViewModel.UpdateAction(oldAction, newAction);
        StateHasChanged();
    }

    private void UpdateActionParameterDate(RuleAction oldAction, string newValue)
    {
        string formattedValue = string.Empty;
        if (DateTime.TryParse(newValue, out var date))
        {
            formattedValue = date.ToString("yyyy-MM-ddTHH:mm");
        }
        var newAction = new RuleAction(oldAction.Type, formattedValue);
        ViewModel.UpdateAction(oldAction, newAction);
        StateHasChanged();
    }

    private RenderFragment RenderNode(RuleNode node, bool isRoot = false) => __builder =>
    {
        <div class="card mb-2 @(isRoot ? "border-primary" : "border-secondary ms-3")">
            <div class="card-header py-1 px-2 d-flex justify-content-between align-items-center @(isRoot ? "bg-primary text-white" : "bg-light")">
                <div class="d-flex align-items-center">
                    <span class="fw-bold me-2">Opérateur Logique :</span>
                    <select class="form-select form-select-sm w-auto d-inline-block py-0" @onchange="@(e => UpdateNodeOperator(node, e))">
                        @foreach (LogicalOperator op in Enum.GetValues(typeof(LogicalOperator)))
                        {
                            <option value="@op" selected="@(node.Operator == op)">@op</option>
                        }
                    </select>
                </div>
                <div>
                    <button class="btn btn-sm py-0 px-2 @(isRoot ? "btn-light text-primary" : "btn-outline-primary") me-1" @onclick="@(() => AddCriterion(node))">+ Critère</button>
                    <button class="btn btn-sm py-0 px-2 @(isRoot ? "btn-light text-primary" : "btn-outline-secondary") me-1" @onclick="@(() => AddChildNode(node))">+ Groupe</button>
                    @if (!isRoot)
                    {
                        <button class="btn btn-sm py-0 px-2 btn-danger" @onclick="@(() => RemoveNode(node))">Supprimer groupe</button>
                    }
                </div>
            </div>
            <div class="card-body p-2">
                @if (!node.Criteria.Any() && !node.ChildNodes.Any())
                {
                    <div class="text-muted fst-italic">Aucun critère ou groupe défini.</div>
                }

                @foreach (var crit in node.Criteria)
                {
                    <div class="row g-1 mb-1 align-items-center">
                        <div class="col-auto">
                            <span class="badge bg-secondary px-2 py-1">Critère</span>
                        </div>
                        <div class="col-md-3">
                            <select class="form-select form-select-sm py-0" @onchange="@(e => UpdateCriterionField(node, crit, e))">
                                @foreach (MailField field in Enum.GetValues(typeof(MailField)))
                                {
                                    <option value="@field" selected="@(crit.Field == field)">@field</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <select class="form-select form-select-sm py-0" @onchange="@(e => UpdateCriterionOperator(node, crit, e))">
                                @foreach (var matchOp in GetAvailableOperators(crit.Field))
                                {
                                    <option value="@matchOp" selected="@(crit.Operator == matchOp)">@matchOp</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            @if (crit.Field == MailField.Category)
                            {
                                var selectedCat = ViewModel.FlatCategories.FirstOrDefault(c => c.FullName == crit.Value);
                                var selectedColor = selectedCat?.Node.EffectiveColor ?? "transparent";
                                var selectedName = selectedCat?.FullName ?? "-- Sélectionner une catégorie --";

                                <div class="dropdown position-relative">
                                    <button class="btn btn-outline-secondary btn-sm py-0 dropdown-toggle w-100 text-start d-flex align-items-center justify-content-between bg-white" type="button" @onclick="@(() => ToggleDropdown(crit))">
                                        <div class="d-flex align-items-center text-truncate">
                                            @if (selectedCat != null)
                                            {
                                                <span style="width: 10px; height: 10px; border-radius: 50%; display: inline-block; background-color: @selectedColor; margin-right: 6px; flex-shrink: 0; border: 1px solid #dee2e6;"></span>
                                            }
                                            <span class="text-truncate">@selectedName</span>
                                        </div>
                                    </button>
                                    @if (IsDropdownOpen(crit))
                                    {
                                        <ul class="dropdown-menu w-100 shadow-sm show" style="display: block; max-height: 240px; overflow-y: auto; position: absolute; z-index: 1050; top: 100%; left: 0; font-size: 0.75rem;">
                                            <li>
                                                <button type="button" class="dropdown-item py-1 text-muted" @onclick="@(() => UpdateCategoryCriterionValue(node, crit, string.Empty))">
                                                    -- Sélectionner une catégorie --
                                                </button>
                                            </li>
                                            @foreach (var cat in ViewModel.FlatCategories)
                                            {
                                                var color = cat.Node.EffectiveColor ?? "transparent";
                                                <li>
                                                    <button type="button" class="dropdown-item py-1 d-flex align-items-center" @onclick="@(() => UpdateCategoryCriterionValue(node, crit, cat.FullName))">
                                                        <span style="width: 10px; height: 10px; border-radius: 50%; display: inline-block; background-color: @color; margin-right: 6px; flex-shrink: 0; border: 1px solid #dee2e6;"></span>
                                                        <span style="white-space: pre-wrap;">@cat.DisplayName</span>
                                                    </button>
                                                </li>
                                            }
                                        </ul>
                                    }
                                </div>
                            }
                            else
                            {
                                <input type="text" class="form-control form-control-sm py-0" value="@crit.Value" @onchange="@(e => UpdateCriterionValue(node, crit, e))" placeholder="Valeur" />
                            }
                        </div>
                        <div class="col-auto">
                            <button class="btn btn-sm btn-outline-danger py-0 px-2" @onclick="@(() => RemoveCriterion(node, crit))">X</button>
                        </div>
                    </div>
                }

                @foreach (var child in node.ChildNodes)
                {
                    <div class="mt-2">
                        @RenderNode(child, false)
                    </div>
                }
            </div>
        </div>
    };

    private bool IsDropdownOpen(RuleCriterion crit) => _dropdownStates.TryGetValue(crit, out var isOpen) && isOpen;

    private void ToggleDropdown(RuleCriterion crit)
    {
        var isOpen = IsDropdownOpen(crit);
        _dropdownStates.Clear();
        _dropdownStates[crit] = !isOpen;
    }

    private void CloseDropdowns()
    {
        _dropdownStates.Clear();
    }

    private IEnumerable<MatchOperator> GetAvailableOperators(MailField field)
    {
        if (field == MailField.Category)
        {
            return new[] { MatchOperator.ExactNode, MatchOperator.NodeAndChildren };
        }
        return new[] { MatchOperator.Equals, MatchOperator.Contains, MatchOperator.RegexMatch };
    }

    private void AddCriterion(RuleNode node)
    {
        ViewModel.AddCriterion(node, new RuleCriterion(MailField.Subject, MatchOperator.Contains, "Nouveau mot-clé"));
        CloseDropdowns();
        StateHasChanged();
    }

    private void AddChildNode(RuleNode node)
    {
        ViewModel.AddChildNode(node, new RuleNode(LogicalOperator.Or));
        CloseDropdowns();
        StateHasChanged();
    }

    private void RemoveCriterion(RuleNode node, RuleCriterion crit)
    {
        ViewModel.RemoveCriterion(node, crit);
        _dropdownStates.Remove(crit);
        StateHasChanged();
    }

    private void RemoveNode(RuleNode nodeToRemove)
    {
        RemoveNodeRecursive(ViewModel.RootNode, nodeToRemove);
        CloseDropdowns();
        StateHasChanged();
    }

    private bool RemoveNodeRecursive(RuleNode current, RuleNode target)
    {
        if (current.ChildNodes.Contains(target))
        {
            current.RemoveChildNode(target);
            return true;
        }

        foreach (var child in current.ChildNodes)
        {
            if (RemoveNodeRecursive(child, target))
            {
                return true;
            }
        }
        return false;
    }

    private void UpdateNodeOperator(RuleNode node, ChangeEventArgs e)
    {
        if (Enum.TryParse<LogicalOperator>(e.Value?.ToString(), out var newOp))
        {
            ViewModel.SetOperator(node, newOp);
            StateHasChanged();
        }
    }

    private void UpdateCriterionField(RuleNode node, RuleCriterion crit, ChangeEventArgs e)
    {
        if (Enum.TryParse<MailField>(e.Value?.ToString(), out var newField))
        {
            MatchOperator newOp = crit.Operator;
            string newValue = crit.Value;

            if (newField == MailField.Category)
            {
                newOp = MatchOperator.ExactNode;
                newValue = ViewModel.FlatCategories.FirstOrDefault()?.FullName ?? string.Empty;
            }
            else if (crit.Field == MailField.Category)
            {
                newOp = MatchOperator.Contains;
                newValue = string.Empty;
            }

            var newCrit = new RuleCriterion(newField, newOp, newValue);
            ViewModel.UpdateCriterion(node, crit, newCrit);
            CloseDropdowns();
            StateHasChanged();
        }
    }

    private void UpdateCriterionOperator(RuleNode node, RuleCriterion crit, ChangeEventArgs e)
    {
        if (Enum.TryParse<MatchOperator>(e.Value?.ToString(), out var newOp))
        {
            var newCrit = new RuleCriterion(crit.Field, newOp, crit.Value);
            ViewModel.UpdateCriterion(node, crit, newCrit);
            CloseDropdowns();
            StateHasChanged();
        }
    }

    private void UpdateCriterionValue(RuleNode node, RuleCriterion crit, ChangeEventArgs e)
    {
        var newValue = e.Value?.ToString() ?? string.Empty;
        var newCrit = new RuleCriterion(crit.Field, crit.Operator, newValue);
        ViewModel.UpdateCriterion(node, crit, newCrit);
        CloseDropdowns();
        StateHasChanged();
    }

    private void UpdateCategoryCriterionValue(RuleNode node, RuleCriterion crit, string newValue)
    {
        var newCrit = new RuleCriterion(crit.Field, crit.Operator, newValue);
        ViewModel.UpdateCriterion(node, crit, newCrit);
        CloseDropdowns();
        StateHasChanged();
    }

    private async Task SaveRuleAsync()
    {
        await ViewModel.SaveRuleAsync();
        await StatusBarVM.RefreshAsync();
        NavManager.NavigateTo("/");
    }
}