@page "/rule-builder"
@using Catamailer.Application.ViewModels
@using Catamailer.Domain
@using System.Linq
@using System
@using System.Threading.Tasks
@using System.Collections.Generic
@inject RuleBuilderViewModel ViewModel
@inject NavigationManager NavManager

