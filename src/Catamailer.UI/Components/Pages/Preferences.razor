<h1 class="cata-page-title">Préférences Générales</h1>
<p class="text-muted mb-4">Configuration globale de l'application Catamailer.</p>

<div class="card shadow-sm border-0 bg-white mb-4">
    <div class="card-header bg-light">
        <h5 class="mb-0">Analyse de l'historique</h5>
    </div>
    <div class="card-body">
        <div class="mb-3">
            <label class="form-label fw-medium">Délai de suspension (Debounce) en minutes</label>
            <input type="number" class="form-control" @bind="ViewModel.DebounceDelayMinutes" min="1" max="1440" />
            <div class="form-text">Temps de pause de l'analyse en arrière-plan après la modification d'une règle, avant que le moteur ne reprenne son traitement.</div>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between mt-4">
    <a href="/" class="btn btn-outline-secondary px-4 shadow-sm">
        ← Retour au Dashboard
    </a>
    <button class="btn btn-primary px-4 shadow-sm" @onclick="SavePreferencesAsync">
        💾 Sauvegarder
    </button>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        await ViewModel.InitializeAsync();
    }

    private async Task SavePreferencesAsync()
    {
        await ViewModel.SaveAsync();
        NavManager.NavigateTo("/");
    }
}