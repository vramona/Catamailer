@page "/preferences"
@using Catamailer.Application.ViewModels
@using System.Threading.Tasks
@inject PreferencesViewModel ViewModel
@inject NavigationManager NavManager

<!-- ------------------------------------------------------------------------------
// <auto-generated>
//     Date de création : 2026-09-15
//     Historique :
