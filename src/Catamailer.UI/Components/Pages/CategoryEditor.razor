@page "/category-editor"
@using Catamailer.Application.ViewModels
@using Catamailer.Domain
@using Catamailer.UI.Components
@inject CategoryTreeViewModel ViewModel
@inject StatusBarViewModel StatusBarVM
@inject NavigationManager Navigation

