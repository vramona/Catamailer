<style>
    .page-container {
        height: calc(100vh - 80px);
        overflow: hidden;
    }
</style>

<div class="d-flex flex-column page-container">
    
    <div class="flex-shrink-0">
        <h1 class="cata-page-title mb-1 fs-4">Éditeur de Référentiel</h1>
        <p class="text-muted mb-3 small">Visualisation de la hiérarchie de la Master Category List (Synchronisation Outlook).</p>
    </div>

    <div class="card shadow-sm border-0 bg-white d-flex flex-column flex-grow-1" style="min-height: 0;">
        <div class="card-body p-3 flex-grow-1" style="overflow-y: auto;">
            @if (ViewModel.RootCategories.Any())
            {
                <div class="ms-n3">
                    <CategoryTreeView Nodes="ViewModel.RootCategories" OnNodeDeleted="ViewModel.DeleteCategoryAsync" />
                </div>
            }
            else
            {
                <div class="alert alert-info border-0 shadow-sm">
                    Aucune catégorie n'est actuellement présente dans le référentiel.
                </div>
            }
        </div>
    </div>
    
    <div class="mt-3 flex-shrink-0">
        <a href="/" class="btn btn-sm btn-outline-secondary px-4 shadow-sm">
            ← Retour au Dashboard
        </a>
    </div>

</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        await ViewModel.InitializeAsync();
    }
}