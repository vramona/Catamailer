<div class="cata-screen-container">
    
    <!-- EN-TÊTE FIXE -->
    <div class="cata-screen-header">
        <h1 class="cata-page-title mb-0">Catégories</h1>
        <p class="text-muted mb-0" style="font-size: 0.72rem;">Visualisation de la hiérarchie de la Master Category List (Synchronisation Outlook).</p>
    </div>

    <!-- CORPS DÉFILANT -->
    <div class="cata-screen-body border rounded bg-white py-1 px-2">
        @if (ViewModel.RootCategories.Any())
        {
            <div class="ms-n2">
                <CategoryTreeView Nodes="ViewModel.RootCategories" OnNodeDeleted="HandleNodeDeletedAsync" />
            </div>
        }
        else
        {
            <div class="alert alert-info border-0 shadow-sm m-2 py-2" style="font-size: 0.75rem;">
                Aucune catégorie n'est actuellement présente dans le référentiel.
            </div>
        }
    </div>
    
    <!-- ZONE D'ACTIONS STANDARDISÉE FIXE EN BAS -->
    <div class="cata-action-bar">
        <button class="btn btn-sm btn-outline-secondary px-3 py-1" style="font-size: 0.75rem;" @onclick='() => Navigation.NavigateTo("/")'>
            Retour Accueil
        </button>
    </div>

</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        await ViewModel.InitializeAsync();
    }

    private async Task HandleNodeDeletedAsync(CategoryNode node)
    {
        await ViewModel.DeleteCategoryAsync(node);
        await StatusBarVM.RefreshAsync();
    }
}