<h1 class="cata-page-title">Éditeur de Référentiel</h1>
<p class="text-muted mb-4">Visualisation de la hiérarchie de la Master Category List (Synchronisation Outlook).</p>

<div class="card shadow-sm border-0 bg-white">
    <div class="card-body p-4">
        @if (ViewModel.RootCategories.Any())
        {
            <div class="ms-n3">
                <CategoryTreeView Nodes="ViewModel.RootCategories" />
            </div>
        }
        else
        {
            <div class="alert alert-info border-0 shadow-sm">
                Aucune catégorie n'est actuellement présente dans le référentiel.
            </div>
        }
    </div>
</div>

<div class="mt-4">
    <a href="/" class="btn btn-outline-secondary px-4 shadow-sm">
        ← Retour au Dashboard
    </a>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        await ViewModel.InitializeAsync();
    }
}