<style>
    .page-container {
        height: calc(100vh - 80px);
        overflow: hidden;
    }
    .table-ultra-compact {
        font-size: 0.75rem;
    }
    .table-ultra-compact th, .table-ultra-compact td {
        padding: 0.2rem 0.4rem;
    }
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: normal;
        word-break: break-word;
    }
    .cat-color-dot {
        width: 0.7rem; 
        height: 0.7rem; 
        border-radius: 50%; 
        display: inline-block;
        flex-shrink: 0;
    }
    .clickable-row {
        cursor: pointer;
        transition: background-color 0.15s ease-in-out;
    }
    .clickable-row:hover {
        background-color: #f8f9fa;
    }
    .accordion-toggle {
        cursor: pointer;
        width: 1.2rem;
        display: inline-block;
        text-align: center;
        user-select: none;
    }
    .accordion-toggle:hover {
        color: #0d6efd !important;
    }
    /* Police monospace pour le select afin que les espaces NBSP fassent la même taille */
    .select-indented {
        font-family: Consolas, monospace;
        font-size: 0.75rem;
    }
</style>

<div class="d-flex flex-column page-container">
    
    <div class="flex-shrink-0">
        <h1 class="cata-page-title mb-1 fs-4">Éditeur de Dictionnaires (Étape 1)</h1>
        <p class="text-muted mb-2 small">Gestion des mots-clés de classification de premier niveau.</p>
    </div>

    <!-- Formulaire d'édition fixe en haut -->
    <div class="card shadow-sm border-0 bg-white mb-2 flex-shrink-0">
        <div class="card-header bg-light py-2">
            <h6 class="mb-0" style="font-size: 0.85rem;">@(ViewModel.IsEditing ? "Modifier la règle" : "Ajouter une nouvelle règle")</h6>
        </div>
        <div class="card-body py-2">
            <div class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label fw-medium mb-1" style="font-size: 0.75rem;">Catégorie Cible <span class="text-danger">*</span></label>
                    <select class="form-select form-select-sm select-indented" @onchange="OnCategorySelected">
                        <option value="" selected="@(ViewModel.SelectedCategory == null)">-- Sélectionner --</option>
                        @if (ViewModel.FlatCategories != null)
                        {
                            @foreach (var opt in ViewModel.FlatCategories)
                            {
                                <option value="@opt.Category.Name" selected="@(ViewModel.SelectedCategory?.Name == opt.Category.Name)">
                                    @opt.DisplayName
                                </option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-medium mb-1" style="font-size: 0.75rem;">Mots-clés (Sujet)</label>
                    <input type="text" class="form-control form-control-sm" style="font-size: 0.75rem;" @bind="ViewModel.SubjectKeywordsInput" @bind:event="oninput" placeholder="ex: urgent, facture" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-medium mb-1" style="font-size: 0.75rem;">Mots-clés (Expéditeur)</label>
                    <input type="text" class="form-control form-control-sm" style="font-size: 0.75rem;" @bind="ViewModel.SenderKeywordsInput" @bind:event="oninput" placeholder="ex: boss@corp.com" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-medium mb-1" style="font-size: 0.75rem;">Mots-clés (Destinataire)</label>
                    <input type="text" class="form-control form-control-sm" style="font-size: 0.75rem;" @bind="ViewModel.RecipientKeywordsInput" @bind:event="oninput" placeholder="ex: team@corp.com" />
                </div>
                
                <div class="col-12 text-end mt-2">
                    @if (ViewModel.IsEditing)
                    {
                        <button class="btn btn-sm btn-outline-danger px-3 me-2 py-1" style="font-size: 0.75rem;" @onclick="DeleteEditingRuleAsync">
                            Supprimer
                        </button>
                        <button class="btn btn-sm btn-outline-secondary px-3 me-2 py-1" style="font-size: 0.75rem;" @onclick="ViewModel.CancelEdit">
                            Annuler
                        </button>
                        <button class="btn btn-sm btn-warning px-3 py-1" style="font-size: 0.75rem;" @onclick="UpdateRuleAsync" disabled="@IsFormInvalid()">
                            Mettre à jour
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-sm btn-primary px-3 py-1" style="font-size: 0.75rem;" @onclick="CreateRuleAsync" disabled="@IsFormInvalid()">
                            Ajouter la règle
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Tableau de règles scrollable -->
    <div class="card shadow-sm border-0 bg-white d-flex flex-column flex-grow-1" style="min-height: 0;">
        <div class="card-header bg-light d-flex justify-content-between align-items-center py-2 flex-shrink-0">
            <h6 class="mb-0" style="font-size: 0.85rem;">Référentiel et Règles associées</h6>
            <div class="w-50">
                <input type="search" class="form-control form-control-sm" style="font-size: 0.75rem;" placeholder="Rechercher (catégorie, mots-clés)..." @bind="ViewModel.SearchText" @bind:event="oninput" />
            </div>
        </div>
        
        <div class="card-body p-0 flex-grow-1" style="overflow-y: auto;">
            <table class="table table-hover table-ultra-compact mb-0" style="table-layout: fixed; width: 100%;">
                <thead class="table-light position-sticky top-0" style="z-index: 1;">
                    <tr>
                        <th scope="col" class="ps-2" style="width: 30%;">Catégorie Cible</th>
                        <th scope="col" style="width: 23%;">Mots-clés (Sujet)</th>
                        <th scope="col" style="width: 23%;">Mots-clés (Expéditeur)</th>
                        <th scope="col" style="width: 24%;">Mots-clés (Destinataire)</th>
                    </tr>
                </thead>
                <tbody>
                    @if (ViewModel.VisibleGridItems != null && ViewModel.VisibleGridItems.Any())
                    {
                        <!-- Obligation d'évaluer ToList() pour que Blazor Virtualize détecte les changements (accordéons) -->
                        <Virtualize Items="@ViewModel.VisibleGridItems.ToList()" Context="item">
                            <tr class="clickable-row @(ViewModel.EditingRule == item.Rule && item.Rule != null ? "table-warning" : "")" @onclick="() => OnRowClicked(item)">
                                <td class="align-middle fw-medium ps-2">
                                    <div class="d-flex align-items-center">
                                        <!-- Indentation stricte -->
                                        <div style="width: @(item.Category.Depth * 1.5)rem; flex-shrink: 0;"></div>
                                        
                                        <!-- Flèche d'accordéon ou espace -->
                                        @if (item.Category.Children.Any())
                                        {
                                            <span class="accordion-toggle text-muted flex-shrink-0" @onclick:stopPropagation="true" @onclick="() => ViewModel.ToggleCategory(item.Category)">
                                                @(item.IsExpanded ? "▼" : "▶")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="flex-shrink-0" style="width: 1.2rem; display: inline-block;"></span>
                                        }

                                        <!-- Point de couleur -->
                                        @if (!string.IsNullOrEmpty(item.Category.Color))
                                        {
                                            <span class="cat-color-dot mx-1 flex-shrink-0" style="background-color: @item.Category.Color;"></span>
                                        }
                                        else
                                        {
                                            <span class="cat-color-dot mx-1 flex-shrink-0" style="background-color: transparent;"></span>
                                        }
                                        
                                        <span class="text-truncate @(item.Rule == null ? "text-muted" : "text-dark")" title="@item.Category.Name">
                                            @item.Category.Name
                                        </span>
                                    </div>
                                </td>
                                <td class="align-middle">
                                    @if (item.Rule != null && item.Rule.SubjectKeywords.Any())
                                    {
                                        var subj = string.Join(", ", item.Rule.SubjectKeywords);
                                        <div class="line-clamp-2" title="@subj">@subj</div>
                                    }
                                    else
                                    {
                                        <span class="text-muted" style="opacity:0.3;">-</span>
                                    }
                                </td>
                                <td class="align-middle">
                                    @if (item.Rule != null && item.Rule.SenderKeywords.Any())
                                    {
                                        var send = string.Join(", ", item.Rule.SenderKeywords);
                                        <div class="line-clamp-2" title="@send">@send</div>
                                    }
                                    else
                                    {
                                        <span class="text-muted" style="opacity:0.3;">-</span>
                                    }
                                </td>
                                <td class="align-middle">
                                    @if (item.Rule != null && item.Rule.RecipientKeywords.Any())
                                    {
                                        var recp = string.Join(", ", item.Rule.RecipientKeywords);
                                        <div class="line-clamp-2" title="@recp">@recp</div>
                                    }
                                    else
                                    {
                                        <span class="text-muted" style="opacity:0.3;">-</span>
                                    }
                                </td>
                            </tr>
                        </Virtualize>
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">
                                @(string.IsNullOrWhiteSpace(ViewModel.SearchText) ? "Aucune catégorie disponible." : "Aucune correspondance pour votre recherche.")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        await ViewModel.InitializeAsync();
    }

    private void OnCategorySelected(ChangeEventArgs e)
    {
        var selectedName = e.Value?.ToString();
        ViewModel.SelectedCategory = ViewModel.AvailableCategories?.FirstOrDefault(c => c.Name == selectedName);
    }

    private void OnRowClicked(DictionaryCategoryItem item)
    {
        if (item.Rule != null)
        {
            ViewModel.EditRule(item.Rule);
        }
        else
        {
            ViewModel.CancelEdit();
            ViewModel.SelectedCategory = item.Category;
        }
    }

    private async Task CreateRuleAsync()
    {
        await ViewModel.CreateRuleFromFormAsync();
    }

    private async Task UpdateRuleAsync()
    {
        await ViewModel.UpdateRuleFromFormAsync();
    }

    private async Task DeleteEditingRuleAsync()
    {
        if (ViewModel.EditingRule != null)
        {
            await ViewModel.DeleteRuleAsync(ViewModel.EditingRule);
            ViewModel.CancelEdit();
        }
    }

    private bool IsFormInvalid()
    {
        return ViewModel.SelectedCategory == null || 
               (string.IsNullOrWhiteSpace(ViewModel.SubjectKeywordsInput) && 
                string.IsNullOrWhiteSpace(ViewModel.SenderKeywordsInput) && 
                string.IsNullOrWhiteSpace(ViewModel.RecipientKeywordsInput));
    }
}