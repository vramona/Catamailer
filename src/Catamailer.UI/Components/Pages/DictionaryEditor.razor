<h1 class="cata-page-title">Éditeur de Dictionnaires (Étape 1)</h1>
<p class="text-muted mb-4">Gestion des mots-clés de classification de premier niveau.</p>

<div class="card shadow-sm border-0 bg-white mb-4">
    <div class="card-header bg-light">
        <h5 class="mb-0">Ajouter une nouvelle règle</h5>
    </div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label fw-medium">Catégorie Cible <span class="text-danger">*</span></label>
                <select class="form-select" @onchange="OnCategorySelected">
                    <option value="" selected="@(ViewModel.SelectedCategory == null)">-- Sélectionner --</option>
                    @if (ViewModel.AvailableCategories != null)
                    {
                        @foreach (var cat in ViewModel.AvailableCategories)
                        {
                            <option value="@cat.Name" selected="@(ViewModel.SelectedCategory?.Name == cat.Name)">
                                @cat.Name
                            </option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-medium">Mots-clés (Sujet)</label>
                <input type="text" class="form-control" @bind="ViewModel.SubjectKeywordsInput" @bind:event="oninput" placeholder="ex: urgent, facture" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-medium">Mots-clés (Expéditeur)</label>
                <input type="text" class="form-control" @bind="ViewModel.SenderKeywordsInput" @bind:event="oninput" placeholder="ex: boss@corp.com" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-medium">Mots-clés (Destinataire)</label>
                <input type="text" class="form-control" @bind="ViewModel.RecipientKeywordsInput" @bind:event="oninput" placeholder="ex: team@corp.com" />
            </div>
            <div class="col-12 text-end mt-3">
                <button class="btn btn-primary px-4" @onclick="CreateRuleAsync" disabled="@(ViewModel.SelectedCategory == null || (string.IsNullOrWhiteSpace(ViewModel.SubjectKeywordsInput) && string.IsNullOrWhiteSpace(ViewModel.SenderKeywordsInput) && string.IsNullOrWhiteSpace(ViewModel.RecipientKeywordsInput)))">
                    Ajouter la règle
                </button>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0 bg-white mb-4">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col" class="ps-4">Catégorie Cible</th>
                    <th scope="col">Mots-clés (Sujet)</th>
                    <th scope="col">Mots-clés (Expéditeur)</th>
                    <th scope="col">Mots-clés (Destinataire)</th>
                    <th scope="col" class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (ViewModel.Rules != null && ViewModel.Rules.Any())
                {
                    @foreach (var rule in ViewModel.Rules)
                    {
                        <tr>
                            <td class="ps-4 align-middle fw-medium">
                                @if (!string.IsNullOrEmpty(rule.TargetCategory.Color))
                                {
                                    <span class="badge me-2" style="background-color: @rule.TargetCategory.Color; width: 1rem; height: 1rem; display: inline-block; vertical-align: middle;">&nbsp;</span>
                                }
                                @rule.TargetCategory.Name
                            </td>
                            <td class="align-middle">
                                @(rule.SubjectKeywords.Any() ? string.Join(", ", rule.SubjectKeywords) : "-")
                            </td>
                            <td class="align-middle">
                                @(rule.SenderKeywords.Any() ? string.Join(", ", rule.SenderKeywords) : "-")
                            </td>
                            <td class="align-middle">
                                @(rule.RecipientKeywords.Any() ? string.Join(", ", rule.RecipientKeywords) : "-")
                            </td>
                            <td class="text-end pe-4 align-middle">
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => ViewModel.DeleteRuleAsync(rule)">
                                    Supprimer
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted">
                            Aucune règle de dictionnaire configurée.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="mt-4">
    <a href="/" class="btn btn-outline-secondary px-4 shadow-sm">
        ← Retour au Dashboard
    </a>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        await ViewModel.InitializeAsync();
    }

    private void OnCategorySelected(ChangeEventArgs e)
    {
        var selectedName = e.Value?.ToString();
        ViewModel.SelectedCategory = ViewModel.AvailableCategories?.FirstOrDefault(c => c.Name == selectedName);
    }

    private async Task CreateRuleAsync()
    {
        await ViewModel.CreateRuleFromFormAsync();
    }
}