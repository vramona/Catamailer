<style>
    .table-ultra-compact {
        font-size: 0.74rem;
        line-height: 1.15;
    }
    .table-ultra-compact th {
        padding: 3px 6px;
    }
    .table-ultra-compact td {
        padding: 1px 6px;
        height: 18px;
    }
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: normal;
        word-break: break-word;
        line-height: 1.1;
    }
    .cat-color-dot {
        width: 0.65rem; 
        height: 0.65rem; 
        border-radius: 50%; 
        display: inline-block;
        flex-shrink: 0;
    }
    .clickable-row {
        cursor: pointer;
    }
    .clickable-row:hover {
        background-color: #f8f9fa;
    }
    .accordion-toggle {
        cursor: pointer;
        width: 1rem;
        font-size: 0.65rem;
        display: inline-block;
        text-align: center;
        user-select: none;
        line-height: 1;
    }
    .accordion-toggle:hover {
        color: #0d6efd !important;
    }
    .select-indented {
        font-family: Consolas, monospace;
        font-size: 0.74rem;
    }
    .tree-indent-guide {
        display: inline-block;
        width: 16px;
        height: 16px;
        border-left: 1px dotted #ced4da;
        flex-shrink: 0;
    }
</style>

<div class="cata-screen-container">
    
    <!-- EN-TÊTE ET FORMULAIRE DE SAISIE FIXES EN HAUT -->
    <div class="cata-screen-header">
        <div class="d-flex justify-content-between align-items-center mb-1">
            <div>
                <h1 class="cata-page-title mb-0">Éditeur de Dictionnaires (Étape 1)</h1>
                <p class="text-muted mb-0" style="font-size: 0.72rem;">Gestion des mots-clés de classification de premier niveau.</p>
            </div>
            <div class="w-25">
                <input type="search" class="form-control form-control-sm py-0" style="font-size: 0.74rem; height: 24px;" placeholder="Rechercher (catégorie, mots-clés)..." @bind="ViewModel.SearchText" @bind:event="oninput" />
            </div>
        </div>

        <div class="card shadow-sm border bg-light">
            <div class="card-body py-1 px-2">
                <div class="row g-2 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label fw-medium mb-0" style="font-size: 0.72rem;">Catégorie Cible <span class="text-danger">*</span></label>
                        <select class="form-select form-select-sm select-indented py-0" style="height: 24px;" @onchange="OnCategorySelected">
                            <option value="" selected="@(ViewModel.SelectedCategory == null)">-- Sélectionner --</option>
                            @if (ViewModel.FlatCategories != null)
                            {
                                var selectedFullName = ViewModel.SelectedCategory?.GetFullName("-");
                                @foreach (var opt in ViewModel.FlatCategories)
                                {
                                    <option value="@opt.FullName" selected="@(string.Equals(selectedFullName, opt.FullName, StringComparison.OrdinalIgnoreCase))">
                                        @opt.DisplayName
                                    </option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-medium mb-0" style="font-size: 0.72rem;">Mots-clés (Sujet)</label>
                        <input type="text" class="form-control form-control-sm py-0" style="font-size: 0.74rem; height: 24px;" @bind="ViewModel.SubjectKeywordsInput" @bind:event="oninput" placeholder="ex: urgent, facture" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-medium mb-0" style="font-size: 0.72rem;">Mots-clés (Expéditeur)</label>
                        <input type="text" class="form-control form-control-sm py-0" style="font-size: 0.74rem; height: 24px;" @bind="ViewModel.SenderKeywordsInput" @bind:event="oninput" placeholder="ex: boss@corp.com" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-medium mb-0" style="font-size: 0.72rem;">Mots-clés (Destinataire)</label>
                        <input type="text" class="form-control form-control-sm py-0" style="font-size: 0.74rem; height: 24px;" @bind="ViewModel.RecipientKeywordsInput" @bind:event="oninput" placeholder="ex: team@corp.com" />
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- CORPS SCROLLABLE : TABLEAU HIÉRARCHIQUE ULTRA-DENSE -->
    <div class="cata-screen-body border rounded bg-white">
        <table class="table table-hover table-ultra-compact mb-0" style="table-layout: fixed; width: 100%;">
            <thead class="table-light position-sticky top-0" style="z-index: 1;">
                <tr>
                    <th scope="col" class="ps-2" style="width: 30%;">Catégorie Cible</th>
                    <th scope="col" style="width: 23%;">Mots-clés (Sujet)</th>
                    <th scope="col" style="width: 23%;">Mots-clés (Expéditeur)</th>
                    <th scope="col" style="width: 24%;">Mots-clés (Destinataire)</th>
                </tr>
            </thead>
            <tbody>
                @if (ViewModel.VisibleGridItems != null && ViewModel.VisibleGridItems.Any())
                {
                    <Virtualize Items="@ViewModel.VisibleGridItems.ToList()" ItemSize="20" Context="item">
                        <tr class="clickable-row @(ViewModel.EditingRule == item.Rule && item.Rule != null ? "table-warning" : (ViewModel.SelectedCategory == item.Category && !ViewModel.IsEditing ? "table-info" : ""))" @onclick="() => OnRowClicked(item)">
                            <td class="align-middle fw-medium ps-2">
                                <div class="d-flex align-items-center" style="padding-left: @(item.Depth * 16)px;">
                                    @if (item.HasChildren)
                                    {
                                        <span class="accordion-toggle text-muted me-1 flex-shrink-0" @onclick:stopPropagation="true" @onclick="() => ViewModel.ToggleCategory(item.Category)" title="Déplier/Replier">
                                            @(item.IsExpanded ? "▼" : "▶")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="me-1 flex-shrink-0" style="width: 1rem; display: inline-block;"></span>
                                    }

                                    @if (!string.IsNullOrEmpty(item.Category.Color))
                                    {
                                        <span class="cat-color-dot me-1 flex-shrink-0" style="background-color: @item.Category.Color;"></span>
                                    }
                                    else if (!string.IsNullOrEmpty(item.Category.EffectiveColor))
                                    {
                                        <span class="cat-color-dot me-1 border flex-shrink-0" style="background-color: @item.Category.EffectiveColor; opacity: 0.6;" title="Couleur héritée"></span>
                                    }
                                    else
                                    {
                                        <span class="cat-color-dot me-1 bg-light border flex-shrink-0"></span>
                                    }
                                    
                                    <span class="text-truncate @(item.Rule == null ? "text-muted fw-normal" : "text-dark fw-semibold")" title="@item.FullName">
                                        @item.Category.Name
                                    </span>
                                </div>
                            </td>
                            <td class="align-middle">
                                @if (item.Rule != null && item.Rule.SubjectKeywords.Any())
                                {
                                    var subj = string.Join(", ", item.Rule.SubjectKeywords);
                                    <div class="line-clamp-2" title="@subj">@subj</div>
                                }
                                else
                                {
                                    <span class="text-muted" style="opacity:0.3;">-</span>
                                }
                            </td>
                            <td class="align-middle">
                                @if (item.Rule != null && item.Rule.SenderKeywords.Any())
                                {
                                    var send = string.Join(", ", item.Rule.SenderKeywords);
                                    <div class="line-clamp-2" title="@send">@send</div>
                                }
                                else
                                {
                                    <span class="text-muted" style="opacity:0.3;">-</span>
                                }
                            </td>
                            <td class="align-middle">
                                @if (item.Rule != null && item.Rule.RecipientKeywords.Any())
                                {
                                    var recp = string.Join(", ", item.Rule.RecipientKeywords);
                                    <div class="line-clamp-2" title="@recp">@recp</div>
                                }
                                else
                                {
                                    <span class="text-muted" style="opacity:0.3;">-</span>
                                }
                            </td>
                        </tr>
                    </Virtualize>
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center py-3 text-muted">
                            @(string.IsNullOrWhiteSpace(ViewModel.SearchText) ? "Aucune catégorie disponible." : "Aucune correspondance pour votre recherche.")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- ZONE D'ACTIONS STANDARDISÉE FIXE EN BAS -->
    <div class="cata-action-bar">
        @if (ViewModel.IsEditing)
        {
            <button class="btn btn-sm btn-outline-danger px-3 py-1" style="font-size: 0.75rem;" @onclick="DeleteEditingRuleAsync">
                Supprimer
            </button>
            <button class="btn btn-sm btn-outline-secondary px-3 py-1" style="font-size: 0.75rem;" @onclick="ViewModel.CancelEdit">
                Annuler l'édition
            </button>
            <button class="btn btn-sm btn-warning px-3 py-1" style="font-size: 0.75rem;" @onclick="UpdateRuleAsync" disabled="@IsFormInvalid()">
                Mettre à jour la règle
            </button>
        }
        else
        {
            <button class="btn btn-sm btn-outline-secondary px-3 py-1" style="font-size: 0.75rem;" @onclick='() => Navigation.NavigateTo("/")'>
                Retour Accueil
            </button>
            <button class="btn btn-sm btn-primary px-3 py-1" style="font-size: 0.75rem;" @onclick="CreateRuleAsync" disabled="@IsFormInvalid()">
                Ajouter la règle
            </button>
        }
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        await ViewModel.InitializeAsync();
    }

    private void OnCategorySelected(ChangeEventArgs e)
    {
        var selectedFullName = e.Value?.ToString();
        ViewModel.SelectedCategory = ViewModel.AvailableCategories?.FirstOrDefault(c =>
            string.Equals(c.GetFullName("-"), selectedFullName, StringComparison.OrdinalIgnoreCase));
    }

    private void OnRowClicked(DictionaryCategoryItem item)
    {
        if (item.Rule != null)
        {
            ViewModel.EditRule(item.Rule);
        }
        else
        {
            ViewModel.CancelEdit();
            ViewModel.SelectedCategory = item.Category;
        }
    }

    private async Task CreateRuleAsync()
    {
        await ViewModel.CreateRuleFromFormAsync();
        await StatusBarVM.RefreshAsync();
    }

    private async Task UpdateRuleAsync()
    {
        await ViewModel.UpdateRuleFromFormAsync();
        await StatusBarVM.RefreshAsync();
    }

    private async Task DeleteEditingRuleAsync()
    {
        if (ViewModel.EditingRule != null)
        {
            await ViewModel.DeleteRuleAsync(ViewModel.EditingRule);
            ViewModel.CancelEdit();
            await StatusBarVM.RefreshAsync();
        }
    }

    private bool IsFormInvalid()
    {
        return ViewModel.SelectedCategory == null || 
               (string.IsNullOrWhiteSpace(ViewModel.SubjectKeywordsInput) && 
                string.IsNullOrWhiteSpace(ViewModel.SenderKeywordsInput) && 
                string.IsNullOrWhiteSpace(ViewModel.RecipientKeywordsInput));
    }
}