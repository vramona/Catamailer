@using Catamailer.Application.ViewModels
@using Catamailer.Domain.Sync
@inject CategorySyncViewModel ViewModel
@inject NavigationManager Navigation

<div class="d-flex flex-column h-100" style="max-height: calc(100vh - 140px);">
    
    <!-- EN-TÊTE FIXE -->
    <div class="d-flex justify-content-between align-items-center mb-3 flex-shrink-0">
        <h3>Synchronisation des Catégories</h3>
        
        <div class="d-flex align-items-center">
            <label for="separator" class="form-label mb-0 me-2 text-nowrap">Séparateur d'arbre :</label>
            <div class="input-group input-group-sm" style="width: 150px;">
                <input type="text" id="separator" class="form-control" @bind="ViewModel.Separator" />
                <button class="btn btn-secondary" @onclick="RefreshAsync">↻</button>
            </div>
        </div>
    </div>

    <!-- CORPS DÉFILANT -->
    <div class="flex-grow-1 overflow-auto pe-2 border rounded p-3 bg-white shadow-sm">
        @if (_isLoading)
        {
            <div class="text-center mt-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Analyse en cours...</span>
                </div>
                <p class="mt-2 text-muted">Analyse des différences entre Outlook et Catamailer...</p>
            </div>
        }
        else if (!ViewModel.HasConflicts)
        {
            <div class="alert alert-success d-flex align-items-center mb-0" role="alert">
                <span class="fs-4 me-3">✅</span>
                <div>
                    <strong>Référentiel synchronisé.</strong><br/>
                    Aucune différence n'a été détectée entre Outlook et Catamailer.
                </div>
            </div>
        }
        else
        {
            <!-- SECTION VUE COMPARÉE GAUCHE/DROITE (ALIGNEMENT PAR LIGNE) -->
            @if (ViewModel.MissingInCatamailerOptions.Any())
            {
                <div class="border rounded mb-4">
                    <!-- Header -->
                    <div class="row g-0 border-bottom bg-light">
                        <div class="col-6 border-end p-2 text-primary fw-bold">Données brutes (Outlook)</div>
                        <div class="col-6 p-2 text-success fw-bold">Projection arborescente (Catamailer)</div>
                    </div>
                    
                    <!-- Ligne "Tout cocher" -->
                    <div class="row g-0 border-bottom bg-light align-items-center">
                        <div class="col-6 border-end py-1 px-2">
                            <span class="text-muted small fw-bold">Catégories détectées</span>
                        </div>
                        <div class="col-6 py-1 px-2 d-flex align-items-center">
                            <input type="checkbox" class="form-check-input me-2 mt-0" @bind="ViewModel.SelectAllMissingInCatamailer" id="selectAllOut" />
                            <label class="text-muted small fw-bold mb-0" for="selectAllOut">Intégration hiérarchique</label>
                        </div>
                    </div>

                    <!-- Lignes de données -->
                    @foreach (var option in ViewModel.MissingInCatamailerOptions)
                    {
                        bool isSync = option.Delta.Status == DeltaStatus.Synchronized;
                        string rowClass = isSync ? "row g-0 border-bottom align-items-center bg-light text-muted" : "row g-0 border-bottom align-items-center hover-bg-light";

                        <div class="@rowClass" style="font-size: 0.9rem; opacity: @(isSync ? "0.6" : "1");">
                            
                            <!-- Gauche (Outlook) -->
                            <div class="col-6 border-end p-1 d-flex justify-content-between align-items-center" style="min-height: 32px;">
                                @if (!option.IsImplicitParent)
                                {
                                    <span class="text-truncate px-2 @(isSync ? "" : "text-dark")">@option.Delta.CategoryName</span>
                                    @if (!string.IsNullOrEmpty(option.Delta.OutlookColor))
                                    {
                                        <span class="badge border ms-2 me-1" style="background-color: @option.Delta.OutlookColor; color: transparent; width: 16px; height: 16px; flex-shrink: 0;">_</span>
                                    }
                                }
                                else
                                {
                                    <span>&nbsp;</span>
                                }
                            </div>
                            
                            <!-- Droite (Catamailer) -->
                            <div class="col-6 p-1 d-flex justify-content-between align-items-center" style="min-height: 32px;">
                                <div style="padding-left: @(8 + option.Depth * 20)px;" class="d-flex align-items-center text-truncate">
                                    @if (isSync)
                                    {
                                        <span class="ms-1 me-3" style="width: 16px; display: inline-block;"></span>
                                    }
                                    else
                                    {
                                        <input type="checkbox" class="form-check-input me-2 mt-0 flex-shrink-0" @bind="option.IsSelected" />
                                    }
                                    <span class="me-2 flex-shrink-0">@(option.IsFolder ? "📁" : "🏷️")</span>
                                    <span class="text-truncate @(isSync ? "" : "text-secondary")">@option.ShortName @(option.IsImplicitParent ? "(Création parent)" : "")</span>
                                </div>
                                @if (!string.IsNullOrEmpty(option.Delta.OptimizedColor) && !isSync)
                                {
                                    <span class="badge border ms-2 me-1" style="background-color: @option.Delta.OptimizedColor; color: transparent; width: 16px; height: 16px; flex-shrink: 0;" title="Couleur explicite rompant l'héritage">_</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            }

            <!-- SECTION CONFLITS DE COULEURS -->
            @if (ViewModel.ColorMismatchOptions.Any())
            {
                <div class="d-flex align-items-center mt-3 mb-2">
                    <input type="checkbox" class="form-check-input me-2 mt-0" @bind="ViewModel.SelectAllColorMismatch" id="selectAllMismatch" />
                    <h5 class="text-warning mb-0">Changements de Couleurs</h5>
                </div>
                <div class="border rounded mb-4">
                    @foreach (var option in ViewModel.ColorMismatchOptions)
                    {
                        <div class="d-flex justify-content-between align-items-center border-bottom p-2 hover-bg-light" style="font-size: 0.9rem;">
                            <div class="d-flex align-items-center">
                                <input type="checkbox" class="form-check-input me-3 mt-0" @bind="option.IsSelected" />
                                <strong>@option.ShortName</strong>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <div class="d-flex align-items-center border rounded px-2 py-1 bg-white">
                                    <span class="text-muted small me-2">Outlook:</span>
                                    <span class="badge border" style="background-color: @option.Delta.OutlookColor; color: transparent; width: 16px; height: 16px;">_</span>
                                </div>
                                
                                <select class="form-select form-select-sm w-auto" @bind="option.Direction" disabled="@(!option.IsSelected)">
                                    <option value="@SyncResolutionDirection.OutlookToCatamailer">Écraser Catamailer</option>
                                    <option value="@SyncResolutionDirection.CatamailerToOutlook">Écraser Outlook</option>
                                </select>

                                <div class="d-flex align-items-center border rounded px-2 py-1 bg-white">
                                    <span class="text-muted small me-2">Catamailer:</span>
                                    <span class="badge border" style="background-color: @option.Delta.CatamailerColor; color: transparent; width: 16px; height: 16px;">_</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }

            <!-- SECTION ORPHELINS OUTLOOK -->
            @if (ViewModel.MissingInOutlookOptions.Any())
            {
                <div class="d-flex align-items-center mt-3 mb-2">
                    <input type="checkbox" class="form-check-input me-2 mt-0" @bind="ViewModel.SelectAllMissingInOutlook" id="selectAllOutOrphan" />
                    <h5 class="text-info mb-0">Catégories à pousser vers Outlook</h5>
                </div>
                <div class="border rounded mb-3">
                    @foreach (var option in ViewModel.MissingInOutlookOptions)
                    {
                        <div class="d-flex justify-content-between align-items-center border-bottom p-2 hover-bg-light" style="font-size: 0.9rem;">
                            <div>
                                <input type="checkbox" class="form-check-input me-2 mt-0" @bind="option.IsSelected" />
                                <span>@option.Delta.CategoryName</span>
                            </div>
                            @if (!string.IsNullOrEmpty(option.Delta.CatamailerColor))
                            {
                                <span class="badge border ms-2" style="background-color: @option.Delta.CatamailerColor; color: transparent; width: 16px; height: 16px;">_</span>
                            }
                        </div>
                    }
                </div>
            }
        }
    </div>

    <!-- PIED DE PAGE FIXE -->
    @if (!_isLoading && ViewModel.HasConflicts)
    {
        <div class="d-flex justify-content-end mt-3 flex-shrink-0 pt-2 border-top">
            <button class="btn btn-outline-secondary me-2 btn-sm" @onclick="IgnoreAsync">Annuler</button>
            <button class="btn btn-primary btn-sm" @onclick="ApplyAsync">Appliquer la synchronisation</button>
        </div>
    }
</div>

@code {
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task RefreshAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        StateHasChanged();
        
        await ViewModel.InitializeAsync();
        
        _isLoading = false;
        StateHasChanged();
    }

    private async Task ApplyAsync()
    {
        await ViewModel.ApplyResolutionsAsync();
        Navigation.NavigateTo("/");
    }

    private void IgnoreAsync()
    {
        Navigation.NavigateTo("/");
    }
}