@using Catamailer.Application.ViewModels
@using Catamailer.Domain.Sync
@inject CategorySyncViewModel ViewModel
@inject StatusBarViewModel StatusBarVM
@inject NavigationManager Navigation

<style>
    .sync-ultra-compact {
        font-size: 0.74rem;
        line-height: 1.15;
    }
    .sync-row-cell {
        padding: 1px 6px;
        min-height: 17px;
    }
    .sync-checkbox {
        width: 0.72rem;
        height: 0.72rem;
        margin-top: 0;
    }
    .sync-color-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        display: inline-block;
        flex-shrink: 0;
    }
    .sync-accordion-toggle {
        cursor: pointer;
        width: 1rem;
        font-size: 0.65rem;
        display: inline-block;
        text-align: center;
        user-select: none;
        line-height: 1;
    }
    .sync-accordion-toggle:hover {
        color: #0d6efd !important;
    }
</style>

<div class="cata-screen-container">
    
    <!-- EN-TÊTE FIXE -->
    <div class="cata-screen-header d-flex justify-content-between align-items-center">
        <div>
            <h1 class="cata-page-title mb-0">Synchronisation des Catégories</h1>
            <p class="text-muted mb-0" style="font-size: 0.72rem;">Analyse et résolution des différences avec Outlook.</p>
        </div>
        
        <div class="d-flex align-items-center">
            <label for="separator" class="form-label mb-0 me-2 text-nowrap fw-medium" style="font-size: 0.75rem;">Séparateur d'arbre :</label>
            <div class="input-group input-group-sm" style="width: 130px;">
                <input type="text" id="separator" class="form-control py-0" style="font-size: 0.75rem;" @bind="ViewModel.Separator" />
                <button class="btn btn-secondary py-0 px-2" style="font-size: 0.75rem;" @onclick="RefreshAsync">↻</button>
            </div>
        </div>
    </div>

    <!-- CORPS DÉFILANT -->
    <div class="cata-screen-body border rounded bg-white shadow-sm sync-ultra-compact">
        @if (_isLoading)
        {
            <div class="text-center mt-4">
                <div class="spinner-border spinner-border-sm text-primary" role="status">
                    <span class="visually-hidden">Analyse en cours...</span>
                </div>
                <p class="mt-2 text-muted">Analyse des différences entre Outlook et Catamailer...</p>
            </div>
        }
        else if (!ViewModel.HasConflicts)
        {
            <div class="alert alert-success d-flex align-items-center m-2 py-2" role="alert">
                <span class="fs-5 me-2">✅</span>
                <div>
                    <strong>Référentiel synchronisé.</strong><br/>
                    Aucune différence n'a été détectée entre Outlook et Catamailer.
                </div>
            </div>
        }
        else
        {
            <div class="p-1">
                <!-- SECTION VUE COMPARÉE GAUCHE/DROITE (ALIGNEMENT PAR LIGNE ULTRA-DENSE) -->
                @if (ViewModel.MissingInCatamailerOptions.Any())
                {
                    <div class="border rounded mb-2">
                        <div class="row g-0 border-bottom bg-light">
                            <div class="col-6 border-end sync-row-cell text-primary fw-bold">Données brutes (Outlook)</div>
                            <div class="col-6 sync-row-cell text-success fw-bold">Projection arborescente (Catamailer)</div>
                        </div>
                        
                        <div class="row g-0 border-bottom bg-light align-items-center">
                            <div class="col-6 border-end sync-row-cell">
                                <span class="text-muted fw-bold">Catégories détectées</span>
                            </div>
                            <div class="col-6 sync-row-cell d-flex align-items-center">
                                <input type="checkbox" class="form-check-input me-2 sync-checkbox" @bind="ViewModel.SelectAllMissingInCatamailer" id="selectAllOut" />
                                <label class="text-muted fw-bold mb-0" for="selectAllOut">Intégration hiérarchique</label>
                            </div>
                        </div>

                        @foreach (var option in ViewModel.VisibleMissingInCatamailerOptions)
                        {
                            bool isSync = option.Delta.Status == DeltaStatus.Synchronized;
                            string rowClass = isSync ? "row g-0 border-bottom align-items-center bg-light text-muted" : "row g-0 border-bottom align-items-center hover-bg-light";

                            <div class="@rowClass" style="opacity: @(isSync ? "0.65" : "1");">
                                
                                <div class="col-6 border-end sync-row-cell d-flex justify-content-between align-items-center">
                                    @if (!option.IsImplicitParent)
                                    {
                                        <span class="text-truncate @(isSync ? "" : "text-dark")">@option.Delta.CategoryName</span>
                                        @if (!string.IsNullOrEmpty(option.Delta.OutlookColor))
                                        {
                                            <span class="border ms-1 sync-color-dot" style="background-color: @option.Delta.OutlookColor;"></span>
                                        }
                                    }
                                    else
                                    {
                                        <span>&nbsp;</span>
                                    }
                                </div>
                                
                                <div class="col-6 sync-row-cell d-flex justify-content-between align-items-center">
                                    <div style="padding-left: @(option.Depth * 14)px;" class="d-flex align-items-center text-truncate">
                                        @if (option.IsFolder)
                                        {
                                            <span class="sync-accordion-toggle text-muted me-1 flex-shrink-0" @onclick="() => ViewModel.ToggleFolder(option)" title="Déplier/Replier">
                                                @(option.IsExpanded ? "▼" : "▶")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="me-1 flex-shrink-0" style="width: 1rem; display: inline-block;"></span>
                                        }

                                        @if (isSync)
                                        {
                                            <span class="me-2" style="width: 0.72rem; display: inline-block;"></span>
                                        }
                                        else
                                        {
                                            <input type="checkbox" class="form-check-input me-2 flex-shrink-0 sync-checkbox" @bind="option.IsSelected" />
                                        }
                                        <span class="me-1 flex-shrink-0" style="font-size: 0.65rem;">@(option.IsFolder ? "📁" : "🏷️")</span>
                                        <span class="text-truncate @(isSync ? "" : "text-secondary")">@option.ShortName @(option.IsImplicitParent ? "(Création parent)" : "")</span>
                                    </div>
                                    @if (!string.IsNullOrEmpty(option.Delta.OptimizedColor) && !isSync)
                                    {
                                        <span class="border ms-1 sync-color-dot" style="background-color: @option.Delta.OptimizedColor;" title="Couleur explicite rompant l'héritage"></span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }

                <!-- SECTION SUPPRESSIONS LOGIQUES EN ATTENTE -->
                @if (ViewModel.DeletedInCatamailerOptions.Any())
                {
                    <div class="d-flex align-items-center mt-2 mb-1">
                        <input type="checkbox" class="form-check-input me-2 border-danger sync-checkbox" @bind="ViewModel.SelectAllDeletedInCatamailer" id="selectAllDeleted" />
                        <h6 class="text-danger mb-0 fw-bold" style="font-size: 0.75rem;">Catégories supprimées à purger</h6>
                    </div>
                    <div class="border border-danger rounded mb-2">
                        @foreach (var option in ViewModel.DeletedInCatamailerOptions)
                        {
                            <div class="d-flex justify-content-between align-items-center border-bottom sync-row-cell hover-bg-light">
                                <div class="d-flex align-items-center">
                                    <input type="checkbox" class="form-check-input me-2 border-danger sync-checkbox" @bind="option.IsSelected" />
                                    <strong class="text-danger">@option.Delta.CategoryName</strong>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <select class="form-select form-select-sm w-auto border-danger py-0" style="font-size: 0.68rem; height: 18px;" @bind="option.Direction" disabled="@(!option.IsSelected)">
                                        <option value="@SyncResolutionDirection.CatamailerToOutlook">Écraser Outlook (Supprimer)</option>
                                        <option value="@SyncResolutionDirection.OutlookToCatamailer">Écraser Catamailer (Restaurer)</option>
                                    </select>
                                </div>
                            </div>
                        }
                    </div>
                }

                <!-- SECTION CONFLITS DE COULEURS -->
                @if (ViewModel.ColorMismatchOptions.Any())
                {
                    <div class="d-flex align-items-center mt-2 mb-1">
                        <input type="checkbox" class="form-check-input me-2 sync-checkbox" @bind="ViewModel.SelectAllColorMismatch" id="selectAllMismatch" />
                        <h6 class="text-warning mb-0 fw-bold" style="font-size: 0.75rem;">Changements de Couleurs</h6>
                    </div>
                    <div class="border rounded mb-2">
                        @foreach (var option in ViewModel.ColorMismatchOptions)
                        {
                            <div class="d-flex justify-content-between align-items-center border-bottom sync-row-cell hover-bg-light">
                                <div class="d-flex align-items-center">
                                    <input type="checkbox" class="form-check-input me-2 sync-checkbox" @bind="option.IsSelected" />
                                    <strong>@option.ShortName</strong>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="d-flex align-items-center border rounded px-1 bg-white">
                                        <span class="text-muted me-1">Outlook:</span>
                                        <span class="border sync-color-dot" style="background-color: @option.Delta.OutlookColor;"></span>
                                    </div>
                                    
                                    <select class="form-select form-select-sm w-auto py-0" style="font-size: 0.68rem; height: 18px;" @bind="option.Direction" disabled="@(!option.IsSelected)">
                                        <option value="@SyncResolutionDirection.OutlookToCatamailer">Écraser Catamailer</option>
                                        <option value="@SyncResolutionDirection.CatamailerToOutlook">Écraser Outlook</option>
                                    </select>

                                    <div class="d-flex align-items-center border rounded px-1 bg-white">
                                        <span class="text-muted me-1">Catamailer:</span>
                                        <span class="border sync-color-dot" style="background-color: @option.Delta.CatamailerColor;"></span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }

                <!-- SECTION ORPHELINS OUTLOOK -->
                @if (ViewModel.MissingInOutlookOptions.Any())
                {
                    <div class="d-flex align-items-center mt-2 mb-1">
                        <input type="checkbox" class="form-check-input me-2 sync-checkbox" @bind="ViewModel.SelectAllMissingInOutlook" id="selectAllOutOrphan" />
                        <h6 class="text-info mb-0 fw-bold" style="font-size: 0.75rem;">Catégories à pousser vers Outlook</h6>
                    </div>
                    <div class="border rounded mb-1">
                        @foreach (var option in ViewModel.MissingInOutlookOptions)
                        {
                            <div class="d-flex justify-content-between align-items-center border-bottom sync-row-cell hover-bg-light">
                                <div>
                                    <input type="checkbox" class="form-check-input me-2 sync-checkbox" @bind="option.IsSelected" />
                                    <span>@option.Delta.CategoryName</span>
                                </div>
                                @if (!string.IsNullOrEmpty(option.Delta.CatamailerColor))
                                {
                                    <span class="border ms-1 sync-color-dot" style="background-color: @option.Delta.CatamailerColor;"></span>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>

    <!-- ZONE D'ACTIONS STANDARDISÉE FIXE EN BAS -->
    <div class="cata-action-bar">
        <button class="btn btn-outline-secondary btn-sm px-3 py-1" style="font-size: 0.75rem;" @onclick="IgnoreAsync">
            @(ViewModel.HasConflicts ? "Annuler" : "Retour Accueil")
        </button>
        @if (!_isLoading && ViewModel.HasConflicts)
        {
            <button class="btn btn-primary btn-sm px-3 py-1" style="font-size: 0.75rem;" @onclick="ApplyAsync">
                Appliquer la synchronisation
            </button>
        }
    </div>
</div>

@code {
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task RefreshAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        StateHasChanged();
        
        await ViewModel.InitializeAsync();
        
        _isLoading = false;
        StateHasChanged();
    }

    private async Task ApplyAsync()
    {
        await ViewModel.ApplyResolutionsAsync();
        await StatusBarVM.RefreshAsync();
        Navigation.NavigateTo("/");
    }

    private void IgnoreAsync()
    {
        Navigation.NavigateTo("/");
    }
}