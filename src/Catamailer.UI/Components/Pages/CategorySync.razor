@using Catamailer.Application.ViewModels
@using Catamailer.Domain.Sync
@inject CategorySyncViewModel ViewModel
@inject NavigationManager Navigation

<style>
    .page-container {
        height: calc(100vh - 80px);
        overflow: hidden;
    }
    .sync-ultra-compact {
        font-size: 0.75rem;
    }
</style>

<div class="d-flex flex-column page-container">
    
    <!-- EN-TÊTE FIXE -->
    <div class="d-flex justify-content-between align-items-center mb-2 flex-shrink-0">
        <div>
            <h1 class="cata-page-title mb-1 fs-4">Synchronisation des Catégories</h1>
            <p class="text-muted mb-2 small">Analyse et résolution des différences avec Outlook.</p>
        </div>
        
        <div class="d-flex align-items-center">
            <label for="separator" class="form-label mb-0 me-2 text-nowrap small fw-medium">Séparateur d'arbre :</label>
            <div class="input-group input-group-sm" style="width: 150px;">
                <input type="text" id="separator" class="form-control" @bind="ViewModel.Separator" />
                <button class="btn btn-secondary" @onclick="RefreshAsync">↻</button>
            </div>
        </div>
    </div>

    <!-- CORPS DÉFILANT -->
    <div class="flex-grow-1 overflow-auto border rounded bg-white shadow-sm sync-ultra-compact">
        @if (_isLoading)
        {
            <div class="text-center mt-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Analyse en cours...</span>
                </div>
                <p class="mt-2 text-muted">Analyse des différences entre Outlook et Catamailer...</p>
            </div>
        }
        else if (!ViewModel.HasConflicts)
        {
            <div class="alert alert-success d-flex align-items-center m-3" role="alert">
                <span class="fs-4 me-3">✅</span>
                <div>
                    <strong class="fs-6">Référentiel synchronisé.</strong><br/>
                    Aucune différence n'a été détectée entre Outlook et Catamailer.
                </div>
            </div>
        }
        else
        {
            <div class="p-2">
                <!-- SECTION VUE COMPARÉE GAUCHE/DROITE (ALIGNEMENT PAR LIGNE) -->
                @if (ViewModel.MissingInCatamailerOptions.Any())
                {
                    <div class="border rounded mb-3">
                        <!-- Header -->
                        <div class="row g-0 border-bottom bg-light">
                            <div class="col-6 border-end px-2 py-1 text-primary fw-bold">Données brutes (Outlook)</div>
                            <div class="col-6 px-2 py-1 text-success fw-bold">Projection arborescente (Catamailer)</div>
                        </div>
                        
                        <!-- Ligne "Tout cocher" -->
                        <div class="row g-0 border-bottom bg-light align-items-center">
                            <div class="col-6 border-end py-1 px-2">
                                <span class="text-muted fw-bold">Catégories détectées</span>
                            </div>
                            <div class="col-6 py-1 px-2 d-flex align-items-center">
                                <input type="checkbox" class="form-check-input me-2 mt-0" @bind="ViewModel.SelectAllMissingInCatamailer" id="selectAllOut" />
                                <label class="text-muted fw-bold mb-0" for="selectAllOut">Intégration hiérarchique</label>
                            </div>
                        </div>

                        <!-- Lignes de données -->
                        @foreach (var option in ViewModel.MissingInCatamailerOptions)
                        {
                            bool isSync = option.Delta.Status == DeltaStatus.Synchronized;
                            string rowClass = isSync ? "row g-0 border-bottom align-items-center bg-light text-muted" : "row g-0 border-bottom align-items-center hover-bg-light";

                            <div class="@rowClass" style="opacity: @(isSync ? "0.6" : "1");">
                                
                                <!-- Gauche (Outlook) -->
                                <div class="col-6 border-end px-2 py-1 d-flex justify-content-between align-items-center" style="min-height: 24px;">
                                    @if (!option.IsImplicitParent)
                                    {
                                        <span class="text-truncate @(isSync ? "" : "text-dark")">@option.Delta.CategoryName</span>
                                        @if (!string.IsNullOrEmpty(option.Delta.OutlookColor))
                                        {
                                            <span class="badge border ms-2" style="background-color: @option.Delta.OutlookColor; color: transparent; width: 12px; height: 12px; flex-shrink: 0;">_</span>
                                        }
                                    }
                                    else
                                    {
                                        <span>&nbsp;</span>
                                    }
                                </div>
                                
                                <!-- Droite (Catamailer) -->
                                <div class="col-6 px-2 py-1 d-flex justify-content-between align-items-center" style="min-height: 24px;">
                                    <div style="padding-left: @(option.Depth * 16)px;" class="d-flex align-items-center text-truncate">
                                        @if (isSync)
                                        {
                                            <span class="ms-1 me-3" style="width: 14px; display: inline-block;"></span>
                                        }
                                        else
                                        {
                                            <input type="checkbox" class="form-check-input me-2 mt-0 flex-shrink-0" @bind="option.IsSelected" style="width: 0.8rem; height: 0.8rem;" />
                                        }
                                        <span class="me-2 flex-shrink-0" style="font-size: 0.7rem;">@(option.IsFolder ? "📁" : "🏷️")</span>
                                        <span class="text-truncate @(isSync ? "" : "text-secondary")">@option.ShortName @(option.IsImplicitParent ? "(Création parent)" : "")</span>
                                    </div>
                                    @if (!string.IsNullOrEmpty(option.Delta.OptimizedColor) && !isSync)
                                    {
                                        <span class="badge border ms-2" style="background-color: @option.Delta.OptimizedColor; color: transparent; width: 12px; height: 12px; flex-shrink: 0;" title="Couleur explicite rompant l'héritage">_</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }

                <!-- SECTION SUPPRESSIONS LOGIQUES EN ATTENTE (NOUVEAU) -->
                @if (ViewModel.DeletedInCatamailerOptions.Any())
                {
                    <div class="d-flex align-items-center mt-3 mb-1">
                        <input type="checkbox" class="form-check-input me-2 mt-0 border-danger" @bind="ViewModel.SelectAllDeletedInCatamailer" id="selectAllDeleted" />
                        <h6 class="text-danger mb-0 fw-bold">Catégories supprimées à purger</h6>
                    </div>
                    <div class="border border-danger rounded mb-3">
                        @foreach (var option in ViewModel.DeletedInCatamailerOptions)
                        {
                            <div class="d-flex justify-content-between align-items-center border-bottom px-2 py-1 hover-bg-light">
                                <div class="d-flex align-items-center">
                                    <input type="checkbox" class="form-check-input me-2 mt-0 border-danger" @bind="option.IsSelected" style="width: 0.8rem; height: 0.8rem;" />
                                    <strong class="text-danger">@option.Delta.CategoryName</strong>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <select class="form-select form-select-sm w-auto border-danger py-0" style="font-size: 0.7rem;" @bind="option.Direction" disabled="@(!option.IsSelected)">
                                        <option value="@SyncResolutionDirection.CatamailerToOutlook">Écraser Outlook (Supprimer)</option>
                                        <option value="@SyncResolutionDirection.OutlookToCatamailer">Écraser Catamailer (Restaurer)</option>
                                    </select>
                                </div>
                            </div>
                        }
                    </div>
                }

                <!-- SECTION CONFLITS DE COULEURS -->
                @if (ViewModel.ColorMismatchOptions.Any())
                {
                    <div class="d-flex align-items-center mt-3 mb-1">
                        <input type="checkbox" class="form-check-input me-2 mt-0" @bind="ViewModel.SelectAllColorMismatch" id="selectAllMismatch" />
                        <h6 class="text-warning mb-0 fw-bold">Changements de Couleurs</h6>
                    </div>
                    <div class="border rounded mb-3">
                        @foreach (var option in ViewModel.ColorMismatchOptions)
                        {
                            <div class="d-flex justify-content-between align-items-center border-bottom px-2 py-1 hover-bg-light">
                                <div class="d-flex align-items-center">
                                    <input type="checkbox" class="form-check-input me-2 mt-0" @bind="option.IsSelected" style="width: 0.8rem; height: 0.8rem;" />
                                    <strong>@option.ShortName</strong>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="d-flex align-items-center border rounded px-1 bg-white">
                                        <span class="text-muted me-1">Outlook:</span>
                                        <span class="badge border" style="background-color: @option.Delta.OutlookColor; color: transparent; width: 12px; height: 12px;">_</span>
                                    </div>
                                    
                                    <select class="form-select form-select-sm w-auto py-0" style="font-size: 0.7rem;" @bind="option.Direction" disabled="@(!option.IsSelected)">
                                        <option value="@SyncResolutionDirection.OutlookToCatamailer">Écraser Catamailer</option>
                                        <option value="@SyncResolutionDirection.CatamailerToOutlook">Écraser Outlook</option>
                                    </select>

                                    <div class="d-flex align-items-center border rounded px-1 bg-white">
                                        <span class="text-muted me-1">Catamailer:</span>
                                        <span class="badge border" style="background-color: @option.Delta.CatamailerColor; color: transparent; width: 12px; height: 12px;">_</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }

                <!-- SECTION ORPHELINS OUTLOOK -->
                @if (ViewModel.MissingInOutlookOptions.Any())
                {
                    <div class="d-flex align-items-center mt-3 mb-1">
                        <input type="checkbox" class="form-check-input me-2 mt-0" @bind="ViewModel.SelectAllMissingInOutlook" id="selectAllOutOrphan" />
                        <h6 class="text-info mb-0 fw-bold">Catégories à pousser vers Outlook</h6>
                    </div>
                    <div class="border rounded mb-2">
                        @foreach (var option in ViewModel.MissingInOutlookOptions)
                        {
                            <div class="d-flex justify-content-between align-items-center border-bottom px-2 py-1 hover-bg-light">
                                <div>
                                    <input type="checkbox" class="form-check-input me-2 mt-0" @bind="option.IsSelected" style="width: 0.8rem; height: 0.8rem;" />
                                    <span>@option.Delta.CategoryName</span>
                                </div>
                                @if (!string.IsNullOrEmpty(option.Delta.CatamailerColor))
                                {
                                    <span class="badge border ms-2" style="background-color: @option.Delta.CatamailerColor; color: transparent; width: 12px; height: 12px;">_</span>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>

    <!-- PIED DE PAGE FIXE -->
    @if (!_isLoading && ViewModel.HasConflicts)
    {
        <div class="d-flex justify-content-end mt-2 flex-shrink-0 pt-2 border-top">
            <button class="btn btn-outline-secondary me-2 btn-sm px-3" @onclick="IgnoreAsync">Annuler</button>
            <button class="btn btn-primary btn-sm px-3" @onclick="ApplyAsync">Appliquer la synchronisation</button>
        </div>
    }
</div>

@code {
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task RefreshAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        StateHasChanged();
        
        await ViewModel.InitializeAsync();
        
        _isLoading = false;
        StateHasChanged();
    }

    private async Task ApplyAsync()
    {
        await ViewModel.ApplyResolutionsAsync();
        Navigation.NavigateTo("/");
    }

    private void IgnoreAsync()
    {
        Navigation.NavigateTo("/");
    }
}